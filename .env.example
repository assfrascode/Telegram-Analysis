APP_NAME=Chat Analyse
APP_ENV=production
# Required public HTTPS origin, for example https://chat.example.com
APP_BASE_URL=
# Required JSON list, for example ["chat.example.com"]
TRUSTED_HOSTS=
# Required hostname from TRUSTED_HOSTS, used by the private backend healthcheck.
HEALTHCHECK_HOST=
# Required: generate at least 32 random bytes; never reuse another credential.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REGISTRATION_ENABLED=false
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_ATTEMPTS_PER_WINDOW=10
AUTH_REGISTER_ATTEMPTS_PER_WINDOW=5
AUTH_TELEGRAM_ATTEMPTS_PER_WINDOW=5
WEBSOCKET_TICKET_EXPIRE_SECONDS=60
# Generic JSON/form cap. Upload and ingest routes use the explicit larger caps below.
MAX_REQUEST_BODY_BYTES=1048576
MAX_CONCURRENT_UPLOADS=1
MAX_INGEST_MEDIA_BYTES=104857600
MAX_INGEST_MESSAGES_BODY_BYTES=16777216
# Required dedicated Fernet key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TELEGRAM_CREDENTIALS_ENCRYPTION_KEY=
TELEGRAM_LOGIN_CHALLENGE_MINUTES=10
TELEGRAM_SYNC_POLL_SECONDS=30
TELEGRAM_SYNC_LEASE_MINUTES=30
TELEGRAM_SYNC_CONCURRENCY=2
TELEGRAM_SYNC_INACTIVITY_TIMEOUT_SECONDS=900
TELEGRAM_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=600
TELEGRAM_SYNC_RETRY_MINUTES=5
TELEGRAM_EXTERNAL_INACTIVITY_TIMEOUT_SECONDS=900
TELEGRAM_EXTERNAL_INITIAL_RESPONSE_TIMEOUT_SECONDS=60
REPORT_SCHEDULER_POLL_SECONDS=30
REPORT_SCHEDULER_LEASE_MINUTES=5

# Required only for a clean install. Use a unique account and password.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chat_analyse
# Required and deliberately has no application-name default.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Required. Use URL-safe ASCII values beginning with a letter because NATS
# resolves these values through its configuration parser.
NATS_USER=app_nats
NATS_PASSWORD=

# AIStor's supported current image; confirm its commercial license/support terms.
MINIO_IMAGE=quay.io/minio/aistor/minio:latest
# Required path to an AIStor free-tier or commercial license; keep it outside Git.
MINIO_LICENSE_FILE=
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET=chat-analyse

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chat_chunks
EMBEDDING_BATCH_SIZE=64

# LibreTranslate is used only when the per-job "Translate" option is enabled.
# Example external service URL: http://libretranslate:5000
LIBRETRANSLATE_BASE_URL=
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_BATCH_SIZE=20
LIBRETRANSLATE_TIMEOUT_SECONDS=60

VLLM_TEXT_BASE_URL=http://vllm-text:8000/v1
VLLM_VISION_BASE_URL=http://vllm-vision:8000/v1
VLLM_EMBEDDING_BASE_URL=http://vllm-embedding:8000/v1
VLLM_RERANKER_BASE_URL=http://vllm-reranker:8000/v1
VLLM_API_KEY=

# OpenAI Audio Transcriptions are used for audio/video transcripts when
# per-job media analysis is enabled. LLM_MOCK_ENABLED=true avoids real calls.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TRANSCRIPTION_MAX_BYTES=26214400
OPENAI_TRANSCRIPTION_TIMEOUT_SECONDS=300
OPENAI_TRANSCRIPTION_BATCH_SIZE=20
OPENAI_TRANSCRIPTION_MAX_ATTEMPTS=3

# Optional vLLM model containers. They are behind the docker compose profile "models".
# Keep LLM_MOCK_ENABLED=true for fast structural tests without GPUs.
# For real embedding/reranking: set LLM_MOCK_ENABLED=false and run:
# docker compose --profile models up --build
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_EMBEDDING_GPU_MEMORY_UTILIZATION=0.35
VLLM_RERANKER_GPU_MEMORY_UTILIZATION=0.35

TEXT_MODEL=google/gemma-4-E2B-it
VISION_MODEL=google/gemma-4-E2B-it
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
PROMPT_LIMIT_SAFETY_TOKENS=256
PROMPT_LIMIT_TIKTOKEN_RATIO=0.75
PROMPT_LIMIT_TIKTOKEN_ENCODING=cl100k_base
PROMPT_LIMIT_CACHE_TTL_SECONDS=300
PROMPT_LIMIT_MODELS_TIMEOUT_SECONDS=10
PROMPT_LIMIT_MOCK_MAX_MODEL_LEN=128000
PROMPT_LIMIT_CHAT_MESSAGE_OVERHEAD_TOKENS=16
PROMPT_LIMIT_RERANK_PAIR_OVERHEAD_TOKENS=16
# Optional JSON fallback only when /v1/models omits max_model_len.
# PROMPT_LIMIT_MAX_MODEL_LEN_OVERRIDES={"Qwen/Qwen3-Embedding-0.6B":32768}
PROMPT_LIMIT_MAX_MODEL_LEN_OVERRIDES={}

MAX_ACTIVE_JOBS=2
MAX_PENDING_MEDIA_TASKS=5000
MAX_PENDING_WORKER_TASKS=10000
MAX_FAILED_RETRYABLE_TASKS=1000
MAX_WORKER_TASK_ATTEMPTS=3
# Optional JSON map. Overrides attempts per NATS subject. Defaults are documented in README.
# WORKER_TASK_MAX_ATTEMPTS_BY_SUBJECT={"jobs.embedding.create":5,"jobs.question.answer":3}
WORKER_TASK_MAX_ATTEMPTS_BY_SUBJECT={}
WORKER_RETRY_BASE_DELAY_SECONDS=10
WORKER_RETRY_MAX_DELAY_SECONDS=300
MAX_UPLOAD_BYTES=1073741824
MAX_EXTRACTED_BYTES=4294967296
MAX_ZIP_FILES=10000
MAX_FILE_BYTES=1073741824
MAX_TELEGRAM_MESSAGE_CHARS=262144
MAX_TELEGRAM_MESSAGES_PER_EXPORT=500000
MAX_HTML_PAGE_BYTES=16777216

DEFAULT_RETRIEVAL_K=50
DEFAULT_RERANK_K=15
ANSWER_CONTEXT_MAX_CHARS=120000

# Fast local tests without real vLLM/reranker servers.
# Set to false when real model endpoints are available.
LLM_MOCK_ENABLED=true
MOCK_EMBEDDING_DIMENSIONS=64

CHUNK_TARGET_CHARS=8000
CHUNK_OVERLAP_MESSAGES=2
VLLM_TEXT_CONCURRENCY=4
VLLM_TEXT_HTTP_MAX_CONNECTIONS=16
VLLM_TEXT_HTTP_MAX_KEEPALIVE_CONNECTIONS=8

MEDIA_ANALYSIS_CONCURRENCY=4
MEDIA_ANALYSIS_BATCH_SIZE=100
MEDIA_ANALYSIS_PROMPT_VERSION=neutral-en-v2
# data_url is easiest locally; internal_presigned_url is better when vLLM can resolve MINIO_ENDPOINT.
MEDIA_ANALYSIS_TRANSPORT=data_url
MAX_INLINE_MEDIA_ANALYSIS_BYTES=26214400
VLLM_MEDIA_REQUEST_TIMEOUT_SECONDS=300
MAX_MEDIA_ANALYSIS_ATTEMPTS=3
# false = failed media are kept visible in the report but do not fail the job.
# true = any permanently failed media item fails the job.
MEDIA_FAIL_JOB_ON_ERROR=false

# Capacity/backpressure. New jobs are rejected when any required dependency is
# unhealthy or one of these thresholds is reached.
MAX_NATS_TASK_STREAM_MESSAGES=10000
CAPACITY_HEALTH_TIMEOUT_SECONDS=2
CAPACITY_REQUIRE_POSTGRES=true
CAPACITY_REQUIRE_MINIO=true
CAPACITY_REQUIRE_NATS=true
CAPACITY_REQUIRE_QDRANT=true

RECOVER_STALE_QUEUED_JOBS=true
STALE_QUEUED_JOB_AFTER_SECONDS=120
STALE_QUEUED_JOB_RECOVERY_LIMIT=100

# Deployment-only settings. The sole published service binds to loopback by
# default; terminate TLS in a host reverse proxy before changing this address.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
SERVER_NAME=
CLIENT_MAX_BODY_SIZE=1g
PROXY_READ_TIMEOUT=300s
PROXY_SEND_TIMEOUT=300s
APP_TMPFS_SIZE=2g
WORKER_TMPFS_SIZE=8g
# Docker images intentionally follow the operator's latest-image policy. For a
# reproducible release, replace these tags with reviewed immutable digests.
POSTGRES_IMAGE=postgres:latest
PYTHON_BASE_IMAGE=python:slim
NODE_BASE_IMAGE=node:slim
NGINX_BASE_IMAGE=nginxinc/nginx-unprivileged:latest
