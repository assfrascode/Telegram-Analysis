# For local development, Vite proxies relative calls to this backend.
VITE_PROXY_TARGET=http://localhost:8000

# For deployed builds, set this to the backend origin.
# Leave blank when the React bundle is served by the same origin as the API.
VITE_API_BASE_URL=

# Optional explicit websocket origin, e.g. ws://localhost:8000
VITE_WS_BASE_URL=
