# Copy this file to .env, fill in every REQUIRED value, and keep .env private.
# Compose runs the collector as the configured host UID/GID and persists its
# complete Telethon session directory in the host path configured below.

# REQUIRED: public Chat Analyse application origin, without a trailing slash.
# For the standard loopback development deployment, use the frontend proxy on
# port 3000; port 8000 is private and direct requests can fail host validation.
BACKEND_URL=http://127.0.0.1:3000
# Development only: permits HTTP when BACKEND_URL is strictly loopback.
TELEGRAM_ALLOW_INSECURE_LOOPBACK_BACKEND_HTTP=true
# REQUIRED: one-time token returned by POST /telegram/ingest/tokens.
TELEGRAM_INGEST_TOKEN=

# REQUIRED: Telegram application credentials from https://my.telegram.org/apps.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional when signing in through the collector web UI; use international form.
TELEGRAM_PHONE=

# This must be absolute. Keep the Docker path unless you also change the volume.
TELEGRAM_SESSION_PATH=/data/telegram-external.session
# Used only to derive the session path when TELEGRAM_SESSION_PATH is empty. The
# Docker image already supplies the explicit /data path above.
XDG_STATE_HOME=

# Canonical marked peer IDs only: -... for groups and -100... for channels.
# Leave empty on the first run to list visible IDs in the log (nothing is then
# registered), or explicitly accept every visible group/channel below.
TELEGRAM_CHAT_IDS=
TELEGRAM_ALL_CHATS=false
# Includes the full Telethon message metadata; leave disabled unless required.
TELEGRAM_INCLUDE_RAW_METADATA=false

# Takeout sessions can help with large historical or media-heavy exports.
TELEGRAM_USE_TAKEOUT=false
TELEGRAM_TAKEOUT_WAIT_TIME=0

# Empty means 31 days before collector startup, providing a timezone/time-of-day
# buffer for reports covering the last 30 days. Otherwise use timezone-aware
# ISO-8601, for example 2026-08-01T00:00:00+00:00.
INITIAL_SYNC_FROM=
TELEGRAM_MAX_SYNC_RANGE_DAYS=31
# Accepted values: 15, 60, 360, or 1440.
SYNC_INTERVAL_MINUTES=60
POLL_SECONDS=15
MESSAGE_BATCH_SIZE=100
# Set either logging interval to 0 to disable those periodic messages.
IDLE_LOG_EVERY=20
MESSAGE_PROGRESS_EVERY=250

# Per-file and per-run media safety limits (bytes/count/seconds).
TELEGRAM_MAX_MEDIA_FILE_BYTES=268435456
TELEGRAM_MAX_MEDIA_BYTES_PER_RUN=1073741824
TELEGRAM_MAX_MEDIA_FILES_PER_RUN=200
TELEGRAM_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=300

# Local authenticated UI. With host networking, it is available at
# http://127.0.0.1:8787 on the Docker host.
COLLECTOR_WEB_ENABLED=true
COLLECTOR_WEB_HOST=127.0.0.1
COLLECTOR_WEB_PORT=8787
# Recommended for Compose. Generate with: openssl rand -base64 32
# If empty for a loopback-only UI, a random password is printed at startup and
# changes at every container recreation.
COLLECTOR_WEB_AUTH_TOKEN=
COLLECTOR_WEB_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
COLLECTOR_WEB_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
COLLECTOR_WEB_MAX_BODY_BYTES=4096
COLLECTOR_WEB_API_REQUESTS_PER_MINUTE=120
COLLECTOR_WEB_LOGIN_ATTEMPTS_PER_MINUTE=6

# Remote UI access is disabled by default. Enabling it requires a non-loopback
# host, an explicit 32+ character auth token, exact host/origin allowlists, and
# browser-trusted TLS files mounted into the container. Also add the commented
# TLS bind mount in docker-compose.yaml.
COLLECTOR_WEB_ALLOW_REMOTE=false
COLLECTOR_WEB_TLS_CERT_FILE=
COLLECTOR_WEB_TLS_KEY_FILE=

# Image/build settings used by Docker Compose.
COLLECTOR_IMAGE=telegram-external-collector:local
COLLECTOR_ENV_FILE=.env
# Host directory bind-mounted at /data. Relative paths are resolved from this
# directory. It may already contain telegram-external.session, or the collector
# creates that file there on first login. Create the directory as this UID/GID.
COLLECTOR_SESSION_DIR=./session
# REQUIRED for Compose: use the numeric output of `id -u` and `id -g` on the
# host. This keeps session files accessible to the same host user for transfer.
COLLECTOR_UID=
COLLECTOR_GID=
PYTHON_BASE_IMAGE=python:slim
