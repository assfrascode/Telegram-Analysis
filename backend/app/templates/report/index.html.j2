<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Chat Analysis Report</title>
  <link rel="stylesheet" href="assets/report.css">
  <script defer src="assets/report.js"></script>
</head>
<body>
  <main class="report-shell report-shell--index">
    <header class="report-hero">
      <div class="report-hero__main">
        <div class="report-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M7 3.75h7.5L19 8.2v12.05H7z" stroke="currentColor" stroke-width="1.6"/>
            <path d="M14.5 3.75V8.2H19M10 12h6M10 15.5h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="report-hero__copy">
          <div class="hero-label-row">
            <span class="status-pill status-pill--ready"><span class="status-dot"></span>Report ready</span>
            <span class="quiet-meta">Offline report</span>
          </div>
          <p class="eyebrow">Chat analysis{% if job.source_name %} · {{ job.source_name }}{% endif %}</p>
          <h1>Analysis report</h1>
          <p class="lead">The key findings first, with every answer linked to its supporting messages.</p>
        </div>
      </div>
      <div class="report-hero__actions">
        <a class="button button--secondary" href="media_gallery.html">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4.75 6.75A2 2 0 0 1 6.75 4.75h10.5a2 2 0 0 1 2 2v10.5a2 2 0 0 1-2 2H6.75a2 2 0 0 1-2-2z" stroke="currentColor" stroke-width="1.6"/>
            <path d="m7.5 16 3.2-3.4 2.15 2.15 1.65-1.65 2.25 2.9M15.75 9.1h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Media
          <span class="button-count">{{ media_gallery|length }}</span>
        </a>
        <time class="generated-at" datetime="{{ generated_at.isoformat() }}">Generated {{ generated_at.strftime("%b %d, %Y · %H:%M UTC") }}</time>
      </div>
    </header>

    <section class="summary-metrics" aria-label="Report overview">
      <div class="metric-card">
        <span class="metric-icon metric-icon--messages" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M5 5.75h14v10.5H9l-4 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </span>
        <div><strong>{{ stats.messages_total }}</strong><span>Messages reviewed</span></div>
      </div>
      <div class="metric-card">
        <span class="metric-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/><path d="M9.85 9.5a2.3 2.3 0 1 1 3.15 2.14c-.7.3-1 .75-1 1.36v.25M12 16.6h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </span>
        <div><strong>{{ stats.questions_total }}</strong><span>Questions</span></div>
      </div>
      <div class="metric-card">
        <span class="metric-icon metric-icon--evidence" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M7 4.75h10v14.5H7zM9.75 8h4.5M9.75 11.5h4.5M9.75 15h2.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <div><strong>{{ stats.evidence_chunks_total }}</strong><span>Evidence sections</span></div>
      </div>
    </section>

    <section class="report-card report-card--highlight">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Executive summary</p>
          <h2>Bottom line</h2>
        </div>
        <span class="section-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="m8.5 12 2.25 2.25 4.75-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/></svg>
        </span>
      </div>
      <pre class="summary-text">{{ bluf }}</pre>
    </section>

    <section class="report-card">
      <div class="section-heading section-heading--with-copy">
        <div>
          <p class="section-kicker">Question reports</p>
          <h2>Explore the findings</h2>
          <p>Open a question to see its answer and the original messages used as evidence.</p>
        </div>
        <span class="count-pill">{{ questions|length }} total</span>
      </div>

      {% if questions %}
      <div class="question-grid">
        {% for q in questions %}
        <a class="question-card" href="{{ q.filename }}">
          <div class="question-card__top">
            <span class="question-index">Q{{ "%02d"|format(q.index) }}</span>
            <span class="evidence-pill">{{ q.evidence|length }} evidence section{% if q.evidence|length != 1 %}s{% endif %}</span>
          </div>
          <h3>{{ q.question }}</h3>
          <p>{{ q.short_answer }}</p>
          <span class="open-link">Open question report <span aria-hidden="true">→</span></span>
        </a>
        {% endfor %}
      </div>
      {% else %}
      <div class="empty-state">
        <span class="empty-state__icon" aria-hidden="true">?</span>
        <h3>No question reports yet</h3>
        <p>This report does not contain any analysis questions.</p>
      </div>
      {% endif %}
    </section>

    <details class="technical-details">
      <summary>
        <span>
          <strong>Technical details</strong>
          <small>Method, models, and internal reference</small>
        </span>
        <span class="details-chevron" aria-hidden="true">⌄</span>
      </summary>
      <div class="technical-details__body">
        <dl class="technical-grid">
          <div><dt>Internal reference</dt><dd><code>{{ job.id }}</code></dd></div>
          <div><dt>Text model</dt><dd>{{ stats.text_model }}</dd></div>
          <div><dt>Vision model</dt><dd>{{ stats.vision_model }}</dd></div>
          <div><dt>Embedding model</dt><dd>{{ stats.embedding_model }}</dd></div>
          <div><dt>Reranker model</dt><dd>{{ stats.reranker_model }}</dd></div>
          <div><dt>Retrieval / rerank</dt><dd>{{ stats.retrieval_k or "–" }} / {{ stats.rerank_k or "–" }}</dd></div>
          <div><dt>Chunks processed</dt><dd>{{ stats.chunks_total }}</dd></div>
          <div><dt>Translation</dt><dd>{{ "Enabled" if stats.translate else "Disabled" }}</dd></div>
          <div><dt>Media analysis</dt><dd>{{ "Enabled" if stats.analyze_media else "Disabled" }}</dd></div>
          <div><dt>Test mode</dt><dd>{{ "Enabled" if stats.mock_enabled else "Disabled" }}</dd></div>
        </dl>
      </div>
    </details>

    <footer class="report-footer">
      <span>Chat Analysis</span>
      <p>Attachment links work when this report stays with its original Telegram export.</p>
    </footer>
  </main>
</body>
</html>
