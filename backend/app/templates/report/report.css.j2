:root {
  color-scheme: dark;
  --bg: #071827;
  --panel: #0B2236;
  --panel-2: #0E2F4F;
  --header: #0E2F4F;
  --accent: #2FA7D6;
  --accent-2: #5D87A8;
  --text: #E6EEF5;
  --muted: #9FB4C7;
  --line: #28465F;
  --warning: #E0A84C;
  --critical: #C94C4C;
  --positive: #4FA36B;
  --telegram-bg: #081C2D;
  --telegram-bubble: #102D44;
  --telegram-bubble-2: #0D263B;
  --shadow: 0 18px 46px rgba(0, 0, 0, 0.28);
  --radius-lg: 18px;
  --radius-md: 13px;
  --radius-sm: 9px;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  min-height: 100vh;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--text);
  background:
    linear-gradient(rgba(47, 167, 214, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(47, 167, 214, 0.035) 1px, transparent 1px),
    radial-gradient(circle at 18% -8%, rgba(47, 167, 214, 0.13), transparent 34rem),
    var(--bg);
  background-size: 32px 32px, 32px 32px, auto, auto;
}

.report-shell {
  width: min(1220px, calc(100vw - 32px));
  margin: 0 auto;
  padding: 28px 0 72px;
}

.report-shell--subreport { width: min(1100px, calc(100vw - 32px)); }

h1, h2, h3, h4, h5, h6, p { margin-top: 0; }

h1 {
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.1rem, 4vw, 4.1rem);
  line-height: 1;
  letter-spacing: -.04em;
  margin: 0 0 16px;
  color: var(--text);
}

h2 {
  font-size: 1.18rem;
  letter-spacing: -.02em;
  margin-bottom: 14px;
  color: var(--text);
}

h3 { font-size: 1rem; color: var(--text); }

a {
  color: var(--accent);
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}

a:hover { color: var(--text); }

code {
  background: rgba(7, 24, 39, .58);
  border: 1px solid rgba(40, 70, 95, .85);
  border-radius: 7px;
  color: #cceeff;
  padding: 1px 6px;
}

pre {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font: inherit;
}

.dossier-header,
.panel,
.bluf-panel,
.answer-panel {
  position: relative;
  background: rgba(11, 34, 54, 0.96);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.dossier-header::before,
.panel::before,
.bluf-panel::before,
.answer-panel::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 3px;
  background: linear-gradient(90deg, var(--accent), var(--accent-2), transparent);
  opacity: .9;
}

.dossier-header {
  padding: 26px;
  margin-bottom: 20px;
  background: linear-gradient(180deg, rgba(14, 47, 79, .98), rgba(11, 34, 54, .98));
}

.subreport-header { margin-top: 14px; }

.panel,
.bluf-panel,
.answer-panel {
  padding: 24px;
  margin-bottom: 20px;
}

.dossier-kicker,
.section-heading-row,
.question-card__top,
.media-card__top,
.evidence-header,
.telegram-header,
.dossier-title-row {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  justify-content: space-between;
}

.dossier-title-row { margin-top: 18px; }

.classification,
.status-pill,
.evidence-chip,
.badge,
.question-index,
.chunk-label {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  min-height: 25px;
  padding: 3px 9px;
  border-radius: 999px;
  border: 1px solid rgba(47, 167, 214, .35);
  background: rgba(47, 167, 214, .10);
  color: var(--accent);
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.classification {
  border-radius: 4px;
  background: rgba(47, 167, 214, .14);
  color: var(--text);
}

.status-pill {
  color: var(--positive);
  background: rgba(79, 163, 107, .10);
  border-color: rgba(79, 163, 107, .32);
}

.badge--warning,
.warning {
  color: var(--warning);
}

.eyebrow,
.section-label {
  color: var(--accent-2);
  text-transform: uppercase;
  letter-spacing: .13em;
  font-size: .71rem;
  font-weight: 850;
  margin-bottom: 8px;
}

.lead {
  max-width: 760px;
  color: var(--muted);
  font-size: 1.04rem;
  line-height: 1.6;
  margin-bottom: 0;
}

.muted {
  color: var(--muted);
  line-height: 1.55;
}

.case-file {
  min-width: min(330px, 100%);
  border: 1px solid rgba(40, 70, 95, .95);
  border-radius: var(--radius-md);
  background: rgba(7, 24, 39, .42);
  padding: 14px;
}

.case-file--compact { min-width: min(280px, 100%); }

.case-file dl,
.meta-list,
.media-meta {
  display: grid;
  gap: 8px 18px;
  margin: 0;
}

.case-file div,
.meta-list div,
.media-meta div {
  min-width: 0;
  border-bottom: 1px solid rgba(40, 70, 95, .72);
  padding-bottom: 7px;
}

dt {
  color: var(--accent-2);
  font-size: .68rem;
  font-weight: 850;
  letter-spacing: .07em;
  text-transform: uppercase;
}

dd {
  margin: 2px 0 0;
  overflow-wrap: anywhere;
  color: var(--text);
}

.top-nav {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  color: var(--muted);
  font-size: .88rem;
  margin-bottom: 14px;
}

.bluf-panel {
  border-color: rgba(47, 167, 214, .32);
  background: linear-gradient(135deg, rgba(11, 34, 54, .98), rgba(14, 47, 79, .94));
}

.bluf-text {
  border-left: 4px solid var(--accent);
  background: rgba(7, 24, 39, .45);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  padding: 16px 18px;
  line-height: 1.65;
  margin-bottom: 14px;
  color: var(--text);
}

.placement-note,
.placement-note-panel p {
  margin: 0;
  color: var(--muted);
  line-height: 1.55;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(300px, .9fr);
  gap: 20px;
}

.dashboard-grid--appendix {
  margin-top: 6px;
}

.panel--wide { min-width: 0; }

.stats-grid {
  display: grid;
  gap: 12px;
}

.stats-grid--primary {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-bottom: 12px;
}

.stats-grid--secondary {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.stat {
  border: 1px solid rgba(40, 70, 95, .9);
  border-radius: var(--radius-md);
  padding: 15px;
  background: rgba(7, 24, 39, .45);
}

.stat span {
  display: block;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 2rem;
  font-weight: 700;
  color: var(--accent);
  line-height: 1;
}

.stat small {
  display: block;
  margin-top: 6px;
  color: var(--muted);
  font-size: .75rem;
  letter-spacing: .05em;
  text-transform: uppercase;
}

.stat--compact span { font-size: 1.55rem; }

.question-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 14px;
}

.question-card {
  display: flex;
  min-height: 230px;
  flex-direction: column;
  justify-content: space-between;
  gap: 16px;
  color: inherit;
  text-decoration: none;
  border: 1px solid rgba(40, 70, 95, .95);
  border-radius: var(--radius-md);
  background: linear-gradient(180deg, rgba(14, 47, 79, .82), rgba(7, 24, 39, .50));
  padding: 18px;
  transition: transform .14s ease, border-color .14s ease, background .14s ease;
}

.question-card:hover {
  transform: translateY(-2px);
  border-color: rgba(47, 167, 214, .75);
  background: linear-gradient(180deg, rgba(14, 47, 79, .96), rgba(7, 24, 39, .58));
}

.question-card h3 {
  font-size: 1.05rem;
  line-height: 1.35;
  margin-bottom: 0;
}

.question-card p {
  color: var(--muted);
  line-height: 1.55;
  margin: 0;
}

.open-link {
  color: var(--accent);
  font-weight: 760;
}

.model-list {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.answer-body {
  color: var(--text);
  line-height: 1.75;
  font-size: 1rem;
}

.evidence-stack {
  display: grid;
  gap: 22px;
}

.evidence {
  border: 1px solid rgba(40, 70, 95, .9);
  border-radius: var(--radius-lg);
  background: rgba(7, 24, 39, .42);
  overflow: hidden;
}

.evidence-header {
  padding: 16px 18px;
  background: rgba(14, 47, 79, .72);
  border-bottom: 1px solid rgba(40, 70, 95, .8);
}

.evidence-header h3 {
  margin: 7px 0 0;
  color: var(--muted);
  font-weight: 600;
}

.chunk-details {
  padding: 0 18px 14px;
  border-bottom: 1px solid rgba(40, 70, 95, .55);
}

.chunk-details summary {
  cursor: pointer;
  color: var(--accent-2);
  padding: 13px 0;
  font-weight: 760;
}

.chunk-text {
  max-height: 380px;
  overflow: auto;
  padding: 14px;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(40, 70, 95, .9);
  background: rgba(7, 24, 39, .62);
  color: var(--muted);
  line-height: 1.55;
}

.message-thread {
  display: grid;
  gap: 14px;
  padding: 20px;
  background:
    linear-gradient(rgba(47, 167, 214, .025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(47, 167, 214, .025) 1px, transparent 1px),
    var(--telegram-bg);
  background-size: 26px 26px, 26px 26px, auto;
}

.telegram-message {
  display: grid;
  grid-template-columns: 38px minmax(0, 1fr);
  gap: 10px;
  align-items: start;
}

.telegram-avatar {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--text);
  background: linear-gradient(145deg, var(--accent-2), var(--accent));
  font-weight: 850;
  box-shadow: 0 8px 18px rgba(0,0,0,.25);
}

.telegram-bubble {
  position: relative;
  max-width: 860px;
  border: 1px solid rgba(40, 70, 95, .82);
  border-radius: 6px 16px 16px 16px;
  background: linear-gradient(180deg, var(--telegram-bubble), var(--telegram-bubble-2));
  padding: 11px 12px 8px;
  box-shadow: 0 10px 22px rgba(0,0,0,.18);
}

.telegram-bubble::before {
  content: "";
  position: absolute;
  left: -7px;
  top: -1px;
  width: 0;
  height: 0;
  border-top: 10px solid var(--telegram-bubble);
  border-left: 8px solid transparent;
}

.telegram-header {
  gap: 10px;
  margin-bottom: 4px;
}

.telegram-sender-block {
  display: flex;
  align-items: baseline;
  gap: 8px;
  flex-wrap: wrap;
}

.sender-name {
  color: var(--accent);
  font-weight: 820;
}

.sender-id {
  color: var(--accent-2);
  font-size: .78rem;
}

.message-anchor {
  white-space: nowrap;
  color: var(--accent-2);
  font-size: .74rem;
  text-decoration: none;
}

.telegram-context {
  border-left: 3px solid var(--accent);
  background: rgba(47, 167, 214, .08);
  color: var(--muted);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  padding: 8px 10px;
  margin: 8px 0;
  font-size: .88rem;
}

.telegram-text {
  margin: 8px 0 0;
  color: var(--text);
  line-height: 1.52;
}

.telegram-footer {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 6px;
  color: var(--accent-2);
  font-size: .72rem;
}

.reaction-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
}

.reaction-chip {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  padding: 2px 9px;
  border-radius: 999px;
  background: rgba(47, 167, 214, .14);
  border: 1px solid rgba(47, 167, 214, .28);
  color: var(--text);
  font-size: .88rem;
  font-weight: 760;
}

.telegram-media-stack {
  display: grid;
  gap: 10px;
  margin-top: 10px;
}

.media-card {
  border: 1px solid rgba(40, 70, 95, .86);
  background: rgba(7, 24, 39, .45);
  border-radius: var(--radius-md);
  padding: 12px;
}

.media-card--failed-permanent,
.media-card--failed-retryable {
  border-color: rgba(224, 168, 76, .55);
}

.media-type {
  color: var(--accent);
  font-weight: 850;
  font-size: .75rem;
  letter-spacing: .08em;
}

.media-path {
  margin: 8px 0;
  color: var(--muted);
}

.media-open {
  display: inline-flex;
  margin: 2px 0 10px;
  font-size: .86rem;
}

.media-description {
  border-left: 3px solid var(--positive);
  background: rgba(79, 163, 107, .08);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  padding: 10px;
  margin-top: 8px;
}

.media-description span {
  display: block;
  color: var(--positive);
  text-transform: uppercase;
  letter-spacing: .08em;
  font-size: .68rem;
  font-weight: 850;
  margin-bottom: 5px;
}

.media-description p {
  margin: 0;
  color: var(--text);
  line-height: 1.55;
}

.media-meta {
  margin-top: 10px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.warning {
  border-left: 3px solid var(--warning);
  background: rgba(224, 168, 76, .08);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  padding: 10px;
  margin: 10px 0 0;
}

.report-highlight .telegram-bubble {
  outline: 2px solid var(--warning);
  outline-offset: 3px;
}

.appendix-panel {
  opacity: .92;
}

@media (max-width: 940px) {
  .dashboard-grid,
  .dossier-title-row {
    grid-template-columns: 1fr;
    display: grid;
  }

  .stats-grid--primary,
  .stats-grid--secondary,
  .model-list,
  .media-meta {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .case-file {
    min-width: 0;
  }
}

@media (max-width: 640px) {
  .report-shell {
    width: min(100vw - 18px, 100%);
    padding-top: 10px;
  }

  .dossier-header,
  .panel,
  .bluf-panel,
  .answer-panel {
    padding: 17px;
    border-radius: 14px;
  }

  .stats-grid--primary,
  .stats-grid--secondary,
  .model-list,
  .media-meta,
  .question-grid {
    grid-template-columns: 1fr;
  }

  .message-thread {
    padding: 12px;
  }

  .telegram-message {
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 8px;
  }

  .telegram-avatar {
    width: 30px;
    height: 30px;
    font-size: .8rem;
  }

  .telegram-header {
    display: block;
  }

  .message-anchor {
    display: inline-block;
    margin-top: 3px;
  }
}

@media print {
  body {
    background: #fff;
    color: #111;
  }

  .dossier-header,
  .panel,
  .bluf-panel,
  .answer-panel,
  .telegram-bubble,
  .media-card {
    box-shadow: none;
  }
}
