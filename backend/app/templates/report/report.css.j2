:root {
  color-scheme: dark;
  --bg: #0b0f14;
  --surface: #131a22;
  --surface-raised: #18212b;
  --surface-soft: #10171f;
  --line: #26313d;
  --line-strong: #354353;
  --text: #f3f6f9;
  --text-soft: #c1cad4;
  --muted: #84909e;
  --accent: #5b8cff;
  --accent-strong: #76a0ff;
  --accent-soft: rgba(91, 140, 255, 0.12);
  --green: #43c995;
  --green-soft: rgba(67, 201, 149, 0.11);
  --amber: #e1ae54;
  --amber-soft: rgba(225, 174, 84, 0.11);
  --red: #ef6b75;
  --shadow: 0 18px 48px rgba(0, 0, 0, 0.24);
  --radius: 14px;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

* { box-sizing: border-box; }

html {
  min-height: 100%;
  scroll-behavior: smooth;
  background: var(--bg);
}

body {
  min-height: 100vh;
  margin: 0;
  color: var(--text);
  background:
    radial-gradient(circle at 72% -12%, rgba(91, 140, 255, 0.1), transparent 34rem),
    radial-gradient(circle at 10% 26%, rgba(91, 140, 255, 0.035), transparent 28rem),
    var(--bg);
  font-size: 15px;
  line-height: 1.5;
}

::selection {
  color: #fff;
  background: rgba(91, 140, 255, 0.48);
}

h1,
h2,
h3,
p,
pre { margin-top: 0; }

h1 {
  margin-bottom: 0.6rem;
  font-size: clamp(2rem, 4vw, 3.35rem);
  line-height: 1.08;
  letter-spacing: -0.045em;
}

h2 {
  margin-bottom: 0;
  font-size: 1.18rem;
  line-height: 1.3;
  letter-spacing: -0.02em;
}

h3 {
  margin-bottom: 0;
  font-size: 1rem;
  line-height: 1.42;
}

p { color: var(--muted); }

a { color: var(--accent-strong); }

a:hover { color: #a9c1ff; }

a:focus-visible,
summary:focus-visible {
  outline: 3px solid rgba(118, 160, 255, 0.38);
  outline-offset: 3px;
}

svg {
  display: block;
  width: 1.15rem;
  height: 1.15rem;
}

code {
  padding: 0.12rem 0.35rem;
  border: 1px solid var(--line);
  border-radius: 6px;
  color: var(--muted);
  background: var(--surface-soft);
  font-size: 0.78rem;
  overflow-wrap: anywhere;
}

pre {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font: inherit;
}

.report-shell {
  width: min(1160px, calc(100vw - 40px));
  margin: 0 auto;
  padding: 32px 0 64px;
}

.report-shell--subreport { width: min(1080px, calc(100vw - 40px)); }

.report-hero,
.report-card,
.technical-details {
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(19, 26, 34, 0.96);
  box-shadow: var(--shadow);
}

.report-hero {
  position: relative;
  display: flex;
  min-height: 220px;
  align-items: flex-end;
  justify-content: space-between;
  gap: 32px;
  margin-bottom: 18px;
  padding: 30px;
  overflow: hidden;
  background:
    linear-gradient(118deg, rgba(91, 140, 255, 0.14), transparent 48%),
    rgba(19, 26, 34, 0.97);
}

.report-hero::before {
  position: absolute;
  inset: 0 0 auto;
  height: 1px;
  content: "";
  background: linear-gradient(90deg, transparent, rgba(118, 160, 255, 0.86), transparent 78%);
}

.report-hero::after {
  position: absolute;
  top: -7rem;
  right: -6rem;
  width: 22rem;
  height: 22rem;
  border-radius: 50%;
  content: "";
  pointer-events: none;
  background: radial-gradient(circle, rgba(91, 140, 255, 0.12), transparent 67%);
}

.report-hero__main {
  position: relative;
  z-index: 1;
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: 18px;
}

.report-mark {
  display: grid;
  width: 48px;
  height: 48px;
  flex: 0 0 auto;
  place-items: center;
  border: 1px solid rgba(118, 160, 255, 0.35);
  border-radius: 13px;
  color: #dce7ff;
  background: linear-gradient(145deg, rgba(91, 140, 255, 0.32), rgba(91, 140, 255, 0.1));
  box-shadow: 0 12px 28px rgba(10, 19, 35, 0.28);
}

.report-mark svg {
  width: 25px;
  height: 25px;
}

.report-hero__copy {
  min-width: 0;
  max-width: 760px;
}

.report-hero__copy h1 { margin-top: 0.25rem; }

.report-hero--question {
  min-height: 230px;
  align-items: center;
}

.report-hero--question h1 {
  max-width: 830px;
  font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  line-height: 1.16;
}

.report-hero--gallery { min-height: 210px; }

.hero-label-row {
  display: flex;
  min-height: 27px;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 16px;
}

.eyebrow,
.section-kicker {
  margin-bottom: 0.3rem;
  color: var(--accent-strong);
  font-size: 0.71rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.lead {
  max-width: 720px;
  margin-bottom: 0;
  color: var(--text-soft);
  font-size: 1rem;
  line-height: 1.6;
}

.report-hero__actions {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 0 0 auto;
  align-items: flex-end;
  flex-direction: column;
  gap: 13px;
}

.status-pill,
.evidence-pill,
.count-pill,
.availability-tag,
.translation-badge,
.reason-tag,
.question-index,
.evidence-index,
.message-count {
  display: inline-flex;
  width: fit-content;
  align-items: center;
  gap: 0.4rem;
  border: 1px solid var(--line);
  border-radius: 999px;
  white-space: nowrap;
  font-size: 0.72rem;
  font-weight: 750;
}

.status-pill {
  min-height: 27px;
  padding: 0.25rem 0.65rem;
  color: var(--text-soft);
  background: rgba(132, 144, 158, 0.08);
}

.status-pill--ready,
.availability-tag--ready {
  border-color: rgba(67, 201, 149, 0.28);
  color: #7fddb8;
  background: var(--green-soft);
}

.status-pill--warning {
  border-color: rgba(225, 174, 84, 0.28);
  color: #edc77f;
  background: var(--amber-soft);
}

.status-dot {
  width: 0.42rem;
  height: 0.42rem;
  flex: 0 0 auto;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 12%, transparent);
}

.quiet-meta,
.generated-at {
  color: var(--muted);
  font-size: 0.76rem;
}

.generated-at { white-space: nowrap; }

.button {
  display: inline-flex;
  min-height: 40px;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  padding: 0.55rem 0.8rem;
  border: 1px solid transparent;
  border-radius: 10px;
  color: var(--text);
  background: var(--accent);
  font-weight: 750;
  text-decoration: none;
  transition: border-color 140ms ease, background 140ms ease, transform 140ms ease;
}

.button:hover {
  color: #fff;
  transform: translateY(-1px);
}

.button--secondary {
  border-color: var(--line-strong);
  background: rgba(24, 33, 43, 0.86);
}

.button--secondary:hover {
  border-color: rgba(118, 160, 255, 0.55);
  background: var(--surface-raised);
}

.button-count {
  display: grid;
  min-width: 21px;
  min-height: 21px;
  place-items: center;
  padding: 0 0.35rem;
  border-radius: 999px;
  color: var(--accent-strong);
  background: var(--accent-soft);
  font-size: 0.7rem;
}

.summary-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 18px;
}

.metric-card {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12px;
  padding: 15px 17px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: rgba(19, 26, 34, 0.88);
  transition: border-color 140ms ease, background 140ms ease;
}

.metric-card:hover {
  border-color: var(--line-strong);
  background: var(--surface-raised);
}

.metric-icon,
.section-icon,
.empty-state__icon {
  display: grid;
  width: 38px;
  height: 38px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 10px;
  color: var(--accent-strong);
  background: var(--accent-soft);
}

.metric-icon--messages {
  color: #75d7c3;
  background: rgba(67, 201, 149, 0.11);
}

.metric-icon--evidence {
  color: #c3a8ff;
  background: rgba(155, 116, 255, 0.11);
}

.metric-card strong,
.metric-card span { display: block; }

.metric-card strong {
  color: var(--text);
  font-size: 1.25rem;
  line-height: 1.1;
}

.metric-card div > span {
  margin-top: 0.2rem;
  color: var(--muted);
  font-size: 0.78rem;
}

.report-card {
  margin-bottom: 18px;
  padding: 24px;
}

.report-card--highlight {
  position: relative;
  border-color: rgba(91, 140, 255, 0.35);
  overflow: hidden;
  background:
    linear-gradient(120deg, rgba(91, 140, 255, 0.11), transparent 45%),
    rgba(19, 26, 34, 0.97);
}

.report-card--highlight::before {
  position: absolute;
  inset: 0 auto 0 0;
  width: 3px;
  content: "";
  background: linear-gradient(180deg, var(--accent), rgba(91, 140, 255, 0.15));
}

.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 18px;
}

.section-heading--with-copy { align-items: center; }

.section-heading p:not(.section-kicker) {
  max-width: 640px;
  margin: 0.38rem 0 0;
  font-size: 0.88rem;
}

.section-icon {
  width: 36px;
  height: 36px;
}

.summary-text {
  margin: 0;
  color: var(--text-soft);
  font-size: 1.01rem;
  line-height: 1.75;
}

.count-pill,
.evidence-pill,
.message-count {
  min-height: 26px;
  padding: 0.22rem 0.58rem;
  color: var(--muted);
  background: var(--surface-soft);
}

.question-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(285px, 1fr));
  gap: 13px;
}

.question-card {
  display: flex;
  min-height: 245px;
  flex-direction: column;
  gap: 15px;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 14px;
  color: inherit;
  background: var(--surface-soft);
  text-decoration: none;
  transition: border-color 150ms ease, background 150ms ease, transform 150ms ease, box-shadow 150ms ease;
}

.question-card:hover {
  border-color: rgba(118, 160, 255, 0.52);
  color: inherit;
  background: var(--surface-raised);
  box-shadow: 0 14px 28px rgba(0, 0, 0, 0.17);
  transform: translateY(-2px);
}

.question-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.question-index,
.evidence-index {
  min-height: 26px;
  padding: 0.2rem 0.55rem;
  border-color: rgba(91, 140, 255, 0.3);
  color: var(--accent-strong);
  background: var(--accent-soft);
  letter-spacing: 0.04em;
}

.question-card h3 {
  font-size: 1.02rem;
  line-height: 1.46;
}

.question-card p {
  display: -webkit-box;
  margin: 0;
  overflow: hidden;
  color: var(--muted);
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.open-link {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin-top: auto;
  color: var(--accent-strong);
  font-size: 0.84rem;
  font-weight: 750;
}

.technical-details {
  margin-top: 18px;
  overflow: hidden;
  box-shadow: none;
  background: rgba(16, 23, 31, 0.72);
}

.technical-details summary,
.source-details summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  cursor: pointer;
  list-style: none;
}

.technical-details summary {
  min-height: 70px;
  padding: 15px 18px;
}

.technical-details summary::-webkit-details-marker,
.source-details summary::-webkit-details-marker { display: none; }

.technical-details summary strong,
.technical-details summary small { display: block; }

.technical-details summary strong {
  color: var(--text-soft);
  font-size: 0.87rem;
}

.technical-details summary small {
  margin-top: 0.18rem;
  color: var(--muted);
}

.details-chevron {
  color: var(--muted);
  transition: transform 160ms ease;
}

.technical-details[open] .details-chevron { transform: rotate(180deg); }

.technical-details__body {
  padding: 0 18px 18px;
  border-top: 1px solid var(--line);
}

.technical-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 28px;
  margin: 0;
}

.technical-grid div {
  display: flex;
  min-width: 0;
  justify-content: space-between;
  gap: 14px;
  padding: 11px 0;
  border-bottom: 1px solid rgba(38, 49, 61, 0.72);
}

.technical-grid dt {
  color: var(--muted);
  font-size: 0.76rem;
}

.technical-grid dd {
  min-width: 0;
  margin: 0;
  color: var(--text-soft);
  font-size: 0.76rem;
  text-align: right;
  overflow-wrap: anywhere;
}

.report-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 22px 4px 0;
  color: var(--muted);
  font-size: 0.75rem;
}

.report-footer span,
.report-footer a { font-weight: 750; }

.report-footer p { margin: 0; }

.top-nav {
  display: flex;
  min-height: 40px;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 12px;
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--text-soft);
  font-size: 0.82rem;
  font-weight: 700;
  text-decoration: none;
}

.back-link:hover { color: var(--text); }

.answer-body {
  color: var(--text-soft);
  font-size: 1rem;
  line-height: 1.78;
  white-space: pre-wrap;
}

.evidence-stack {
  display: grid;
  gap: 16px;
}

.evidence {
  border: 1px solid var(--line);
  border-radius: 15px;
  overflow: hidden;
  background: var(--surface-soft);
}

.evidence-header {
  display: flex;
  min-height: 76px;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 15px 18px;
  border-bottom: 1px solid var(--line);
  background: rgba(24, 33, 43, 0.72);
}

.evidence-header h3 {
  margin-top: 0.45rem;
  color: var(--muted);
  font-size: 0.78rem;
  font-weight: 600;
}

.message-thread {
  display: grid;
  gap: 13px;
  padding: 18px;
  background:
    radial-gradient(circle at 100% 0, rgba(91, 140, 255, 0.04), transparent 22rem),
    #0d141c;
}

.telegram-message {
  display: grid;
  grid-template-columns: 36px minmax(0, 1fr);
  align-items: start;
  gap: 9px;
}

.telegram-avatar {
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  border: 1px solid rgba(118, 160, 255, 0.27);
  border-radius: 50%;
  color: #dce7ff;
  background: linear-gradient(145deg, rgba(91, 140, 255, 0.45), rgba(91, 140, 255, 0.18));
  font-size: 0.78rem;
  font-weight: 800;
}

.telegram-bubble {
  position: relative;
  width: min(850px, 100%);
  padding: 11px 12px 8px;
  border: 1px solid var(--line);
  border-radius: 6px 14px 14px 14px;
  background: #17232e;
  box-shadow: 0 8px 18px rgba(0, 0, 0, 0.14);
}

.telegram-bubble::before {
  position: absolute;
  top: -1px;
  left: -7px;
  width: 0;
  height: 0;
  border-top: 10px solid #17232e;
  border-left: 8px solid transparent;
  content: "";
}

.telegram-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.sender-name {
  color: #8eafff;
  font-size: 0.82rem;
  font-weight: 800;
}

.message-anchor {
  display: grid;
  width: 25px;
  height: 25px;
  place-items: center;
  border-radius: 7px;
  color: var(--muted);
  opacity: 0.28;
  transition: color 140ms ease, background 140ms ease, opacity 140ms ease;
}

.telegram-bubble:hover .message-anchor,
.message-anchor:focus-visible {
  color: var(--accent-strong);
  opacity: 1;
  background: var(--accent-soft);
}

.message-anchor svg {
  width: 14px;
  height: 14px;
}

.message-context {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 7px;
}

.message-context span,
.translation-badge {
  min-height: 23px;
  padding: 0.16rem 0.48rem;
  color: var(--muted);
  background: rgba(132, 144, 158, 0.08);
}

.telegram-text {
  margin: 7px 0 0;
  color: var(--text);
  line-height: 1.55;
}

.empty-message {
  margin: 8px 0 2px;
  color: var(--muted);
  font-style: italic;
}

.translation-badge {
  margin-top: 9px;
  border-color: rgba(91, 140, 255, 0.28);
  color: var(--accent-strong);
  background: var(--accent-soft);
}

.translation-panel {
  margin-top: 10px;
  padding: 10px 11px;
  border-left: 2px solid var(--accent);
  border-radius: 0 9px 9px 0;
  background: var(--accent-soft);
}

.translation-panel > span {
  color: var(--accent-strong);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.translation-panel pre {
  margin: 5px 0 0;
  color: var(--text-soft);
  line-height: 1.55;
}

.original-text-details {
  margin-top: 8px;
  color: var(--muted);
}

.original-text-details summary {
  width: fit-content;
  font-size: 0.72rem;
  font-weight: 700;
}

.original-text-details summary:hover { color: var(--text-soft); }

.original-text-details pre {
  margin: 7px 0 0;
  padding: 9px 10px;
  border-left: 2px solid var(--line-strong);
  border-radius: 0 8px 8px 0;
  color: var(--text-soft);
  background: rgba(132, 144, 158, 0.06);
  line-height: 1.55;
}

.attachment-stack {
  display: grid;
  gap: 7px;
  margin-top: 10px;
}

.attachment-row {
  display: flex;
  min-height: 51px;
  align-items: center;
  gap: 10px;
  padding: 7px 9px;
  border: 1px solid var(--line);
  border-radius: 10px;
  color: var(--text-soft);
  background: rgba(11, 15, 20, 0.3);
  text-decoration: none;
  transition: border-color 140ms ease, background 140ms ease;
}

a.attachment-row:hover {
  border-color: rgba(118, 160, 255, 0.45);
  color: var(--text);
  background: rgba(91, 140, 255, 0.08);
}

.attachment-row--unavailable {
  border-color: rgba(225, 174, 84, 0.22);
  background: var(--amber-soft);
}

.attachment-icon {
  display: grid;
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 9px;
  color: var(--accent-strong);
  background: var(--accent-soft);
}

.attachment-row--unavailable .attachment-icon {
  color: var(--amber);
  background: var(--amber-soft);
}

.attachment-copy {
  display: block;
  min-width: 0;
}

.attachment-copy strong,
.attachment-copy small { display: block; }

.attachment-copy strong {
  color: var(--text-soft);
  font-size: 0.8rem;
}

.attachment-copy small {
  margin-top: 0.1rem;
  color: var(--muted);
  font-size: 0.68rem;
}

.attachment-action {
  margin-left: auto;
  color: var(--accent-strong);
  font-size: 0.76rem;
  font-weight: 750;
}

.reason-tag {
  min-height: 24px;
  margin-left: auto;
  padding: 0.16rem 0.5rem;
  border-color: rgba(225, 174, 84, 0.28);
  color: #edc77f;
  background: var(--amber-soft);
}

.reaction-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 8px;
}

.reaction-chip {
  display: inline-flex;
  min-height: 23px;
  align-items: center;
  padding: 0.12rem 0.48rem;
  border: 1px solid rgba(91, 140, 255, 0.23);
  border-radius: 999px;
  color: var(--text-soft);
  background: var(--accent-soft);
  font-size: 0.77rem;
}

.telegram-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 6px;
  color: var(--muted);
  font-size: 0.68rem;
}

.source-details {
  border-top: 1px solid var(--line);
  background: rgba(11, 15, 20, 0.25);
}

.source-details summary {
  min-height: 44px;
  padding: 9px 18px;
  color: var(--muted);
  font-size: 0.75rem;
  font-weight: 700;
}

.source-details summary:hover { color: var(--text-soft); }

.chunk-text {
  max-height: 360px;
  margin: 0 18px 16px;
  padding: 13px;
  overflow: auto;
  border: 1px solid var(--line);
  border-radius: 9px;
  color: var(--muted);
  background: #0b1118;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 0.72rem;
  line-height: 1.55;
}

.inline-notice {
  display: grid;
  gap: 2px;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 10px;
  color: var(--text-soft);
  background: var(--surface-soft);
}

.inline-notice span {
  color: var(--muted);
  font-size: 0.78rem;
}

.inline-notice--warning { border-color: rgba(225, 174, 84, 0.28); }

.media-gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(275px, 1fr));
  gap: 13px;
}

.media-gallery-card {
  display: flex;
  min-width: 0;
  min-height: 220px;
  flex-direction: column;
  padding: 17px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface-soft);
  transition: border-color 140ms ease, background 140ms ease, transform 140ms ease;
}

.media-gallery-card:hover {
  border-color: var(--line-strong);
  background: var(--surface-raised);
  transform: translateY(-1px);
}

.media-gallery-card--unavailable { border-color: rgba(225, 174, 84, 0.22); }

.media-gallery-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 15px;
}

.availability-tag {
  min-height: 25px;
  padding: 0.18rem 0.55rem;
}

.availability-tag--warning {
  border-color: rgba(225, 174, 84, 0.28);
  color: #edc77f;
  background: var(--amber-soft);
}

.media-type {
  color: var(--accent-strong);
  font-size: 0.66rem;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.media-gallery-card h3 {
  margin-top: 0.3rem;
  overflow-wrap: anywhere;
}

.media-byline {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 0.45rem;
  color: var(--muted);
  font-size: 0.72rem;
}

.media-open {
  width: fit-content;
  min-height: 36px;
  margin-top: auto;
  padding: 0.42rem 0.7rem;
  font-size: 0.78rem;
}

.media-reason {
  display: flex;
  width: fit-content;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: auto;
  padding: 0.32rem 0.55rem;
  border: 1px solid rgba(225, 174, 84, 0.25);
  border-radius: 999px;
  color: #edc77f;
  background: var(--amber-soft);
  font-size: 0.71rem;
}

.media-reason span {
  color: var(--muted);
  font-weight: 650;
}

.empty-state {
  display: grid;
  min-height: 220px;
  place-items: center;
  align-content: center;
  padding: 28px;
  border: 1px dashed var(--line-strong);
  border-radius: 14px;
  text-align: center;
  background: var(--surface-soft);
}

.empty-state__icon {
  margin-bottom: 11px;
  font-weight: 800;
}

.empty-state h3 { margin-bottom: 0.3rem; }

.empty-state p {
  max-width: 440px;
  margin-bottom: 0;
}

.empty-state--warning {
  border-color: rgba(225, 174, 84, 0.35);
}

.empty-state--warning .empty-state__icon {
  color: var(--amber);
  background: var(--amber-soft);
}

.report-highlight .telegram-bubble {
  outline: 2px solid var(--accent-strong);
  outline-offset: 3px;
  animation: report-pulse 1.2s ease-out 1;
}

@keyframes report-pulse {
  0% { box-shadow: 0 0 0 0 rgba(91, 140, 255, 0.45); }
  100% { box-shadow: 0 0 0 12px rgba(91, 140, 255, 0); }
}

@media (max-width: 820px) {
  .report-hero {
    min-height: 0;
    align-items: flex-start;
    flex-direction: column;
  }

  .report-hero__actions {
    width: 100%;
    align-items: flex-start;
  }

  .summary-metrics { grid-template-columns: 1fr; }
  .technical-grid { grid-template-columns: 1fr; }
}

@media (max-width: 600px) {
  body { font-size: 14px; }

  .report-shell {
    width: calc(100vw - 18px);
    padding: 10px 0 36px;
  }

  .report-hero,
  .report-card {
    padding: 17px;
    border-radius: 14px;
  }

  .report-hero__main { gap: 12px; }

  .report-mark {
    width: 40px;
    height: 40px;
    border-radius: 11px;
  }

  .report-mark svg {
    width: 21px;
    height: 21px;
  }

  .question-grid,
  .media-gallery-grid { grid-template-columns: 1fr; }

  .section-heading--with-copy,
  .evidence-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .message-thread { padding: 12px; }

  .telegram-message {
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 7px;
  }

  .telegram-avatar {
    width: 28px;
    height: 28px;
    font-size: 0.68rem;
  }

  .attachment-row { align-items: flex-start; }

  .attachment-action,
  .reason-tag {
    align-self: center;
    margin-left: auto;
  }

  .report-footer {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;
  }
}

@media print {
  :root { color-scheme: light; }

  body {
    color: #17202a;
    background: #fff;
  }

  .report-shell { width: 100%; }

  .report-hero,
  .report-card,
  .technical-details,
  .metric-card,
  .evidence,
  .telegram-bubble,
  .question-card,
  .media-gallery-card {
    border-color: #d8dee6;
    color: #17202a;
    background: #fff;
    box-shadow: none;
  }

  .report-hero__actions,
  .top-nav,
  .message-anchor,
  .report-footer { display: none; }

  .summary-text,
  .answer-body,
  .telegram-text,
  .question-card h3 { color: #17202a; }
}
