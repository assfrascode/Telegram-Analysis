:root {
  color-scheme: dark;
  --bg: #0b0f14;
  --surface: #131a22;
  --surface-raised: #18212b;
  --surface-soft: #10171f;
  --line: #26313d;
  --line-strong: #354353;
  --text: #f3f6f9;
  --text-soft: #c1cad4;
  --muted: #84909e;
  --accent: #5b8cff;
  --accent-strong: #76a0ff;
  --accent-soft: rgba(91, 140, 255, 0.12);
  --green: #43c995;
  --green-soft: rgba(67, 201, 149, 0.11);
  --amber: #e1ae54;
  --amber-soft: rgba(225, 174, 84, 0.11);
  --red: #ef6b75;
  --shadow: 0 18px 48px rgba(0, 0, 0, 0.24);
  --radius: 14px;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

* { box-sizing: border-box; }

html {
  min-height: 100%;
  scroll-behavior: smooth;
  background: var(--bg);
}

body {
  min-height: 100vh;
  margin: 0;
  color: var(--text);
  background:
    radial-gradient(circle at 72% -12%, rgba(91, 140, 255, 0.1), transparent 34rem),
    radial-gradient(circle at 10% 26%, rgba(91, 140, 255, 0.035), transparent 28rem),
    var(--bg);
  font-size: 15px;
  line-height: 1.5;
}

::selection {
  color: #fff;
  background: rgba(91, 140, 255, 0.48);
}

h1,
h2,
h3,
p,
pre { margin-top: 0; }

h1 {
  margin-bottom: 0.6rem;
  font-size: clamp(2rem, 4vw, 3.35rem);
  line-height: 1.08;
  letter-spacing: -0.045em;
}

h2 {
  margin-bottom: 0;
  font-size: 1.18rem;
  line-height: 1.3;
  letter-spacing: -0.02em;
}

h3 {
  margin-bottom: 0;
  font-size: 1rem;
  line-height: 1.42;
}

p { color: var(--muted); }

a { color: var(--accent-strong); }

a:hover { color: #a9c1ff; }

a:focus-visible,
summary:focus-visible {
  outline: 3px solid rgba(118, 160, 255, 0.38);
  outline-offset: 3px;
}

svg {
  display: block;
  width: 1.15rem;
  height: 1.15rem;
}

code {
  padding: 0.12rem 0.35rem;
  border: 1px solid var(--line);
  border-radius: 6px;
  color: var(--muted);
  background: var(--surface-soft);
  font-size: 0.78rem;
  overflow-wrap: anywhere;
}

pre {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font: inherit;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.report-shell {
  width: min(1160px, calc(100vw - 40px));
  margin: 0 auto;
  padding: 32px 0 64px;
}

.report-shell--subreport { width: min(1080px, calc(100vw - 40px)); }
.report-shell--gallery { width: min(1320px, calc(100vw - 40px)); }

.report-hero,
.report-card,
.technical-details {
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(19, 26, 34, 0.96);
  box-shadow: var(--shadow);
}

.report-hero {
  position: relative;
  display: flex;
  min-height: 220px;
  align-items: flex-end;
  justify-content: space-between;
  gap: 32px;
  margin-bottom: 18px;
  padding: 30px;
  overflow: hidden;
  background:
    linear-gradient(118deg, rgba(91, 140, 255, 0.14), transparent 48%),
    rgba(19, 26, 34, 0.97);
}

.report-hero::before {
  position: absolute;
  inset: 0 0 auto;
  height: 1px;
  content: "";
  background: linear-gradient(90deg, transparent, rgba(118, 160, 255, 0.86), transparent 78%);
}

.report-hero::after {
  position: absolute;
  top: -7rem;
  right: -6rem;
  width: 22rem;
  height: 22rem;
  border-radius: 50%;
  content: "";
  pointer-events: none;
  background: radial-gradient(circle, rgba(91, 140, 255, 0.12), transparent 67%);
}

.report-hero__main {
  position: relative;
  z-index: 1;
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: 18px;
}

.report-mark {
  display: grid;
  width: 48px;
  height: 48px;
  flex: 0 0 auto;
  place-items: center;
  border: 1px solid rgba(118, 160, 255, 0.35);
  border-radius: 13px;
  color: #dce7ff;
  background: linear-gradient(145deg, rgba(91, 140, 255, 0.32), rgba(91, 140, 255, 0.1));
  box-shadow: 0 12px 28px rgba(10, 19, 35, 0.28);
}

.report-mark svg {
  width: 25px;
  height: 25px;
}

.report-hero__copy {
  min-width: 0;
  max-width: 760px;
}

.report-hero__copy h1 { margin-top: 0.25rem; }

.report-hero--question {
  min-height: 230px;
  align-items: center;
}

.report-hero--question h1 {
  max-width: 830px;
  font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  line-height: 1.16;
}

.report-hero--gallery { min-height: 210px; }

.hero-label-row {
  display: flex;
  min-height: 27px;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 16px;
}

.eyebrow,
.section-kicker {
  margin-bottom: 0.3rem;
  color: var(--accent-strong);
  font-size: 0.71rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.lead {
  max-width: 720px;
  margin-bottom: 0;
  color: var(--text-soft);
  font-size: 1rem;
  line-height: 1.6;
}

.report-hero__actions {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 0 0 auto;
  align-items: flex-end;
  flex-direction: column;
  gap: 13px;
}

.report-hero__buttons,
.top-nav__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 9px;
}

.theme-toggle {
  white-space: nowrap;
  cursor: pointer;
}

.theme-toggle--compact {
  display: inline-flex;
  min-height: 34px;
  align-items: center;
  gap: 0.45rem;
  padding: 0.38rem 0.62rem;
  border: 1px solid var(--line-strong);
  border-radius: 9px;
  color: var(--text-soft);
  background: var(--surface);
  font: inherit;
  font-size: 0.75rem;
  font-weight: 750;
  transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
}

.theme-toggle--compact:hover {
  border-color: rgba(118, 160, 255, 0.55);
  color: var(--text);
  background: var(--surface-raised);
}

.theme-toggle:focus-visible {
  outline: 3px solid rgba(118, 160, 255, 0.38);
  outline-offset: 2px;
}

.theme-toggle__moon { display: none; }

:root[data-theme="light"] .theme-toggle__sun { display: none; }
:root[data-theme="light"] .theme-toggle__moon { display: block; }

.status-pill,
.evidence-pill,
.count-pill,
.availability-tag,
.translation-badge,
.reason-tag,
.question-index,
.evidence-index,
.message-count {
  display: inline-flex;
  width: fit-content;
  align-items: center;
  gap: 0.4rem;
  border: 1px solid var(--line);
  border-radius: 999px;
  white-space: nowrap;
  font-size: 0.72rem;
  font-weight: 750;
}

.status-pill {
  min-height: 27px;
  padding: 0.25rem 0.65rem;
  color: var(--text-soft);
  background: rgba(132, 144, 158, 0.08);
}

.status-pill--ready,
.availability-tag--ready {
  border-color: rgba(67, 201, 149, 0.28);
  color: #7fddb8;
  background: var(--green-soft);
}

.status-pill--warning {
  border-color: rgba(225, 174, 84, 0.28);
  color: #edc77f;
  background: var(--amber-soft);
}

.status-dot {
  width: 0.42rem;
  height: 0.42rem;
  flex: 0 0 auto;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 12%, transparent);
}

.quiet-meta,
.generated-at {
  color: var(--muted);
  font-size: 0.76rem;
}

.generated-at { white-space: nowrap; }

.button {
  display: inline-flex;
  min-height: 40px;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  padding: 0.55rem 0.8rem;
  border: 1px solid transparent;
  border-radius: 10px;
  color: var(--text);
  background: var(--accent);
  font-weight: 750;
  text-decoration: none;
  transition: border-color 140ms ease, background 140ms ease, transform 140ms ease;
}

.button:hover {
  color: #fff;
  transform: translateY(-1px);
}

.button--secondary {
  border-color: var(--line-strong);
  background: rgba(24, 33, 43, 0.86);
}

.button--secondary:hover {
  border-color: rgba(118, 160, 255, 0.55);
  background: var(--surface-raised);
}

.button-count {
  display: grid;
  min-width: 21px;
  min-height: 21px;
  place-items: center;
  padding: 0 0.35rem;
  border-radius: 999px;
  color: var(--accent-strong);
  background: var(--accent-soft);
  font-size: 0.7rem;
}

.summary-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 18px;
}

.metric-card {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12px;
  padding: 15px 17px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: rgba(19, 26, 34, 0.88);
  transition: border-color 140ms ease, background 140ms ease;
}

.metric-card:hover {
  border-color: var(--line-strong);
  background: var(--surface-raised);
}

.metric-icon,
.section-icon,
.empty-state__icon {
  display: grid;
  width: 38px;
  height: 38px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 10px;
  color: var(--accent-strong);
  background: var(--accent-soft);
}

.metric-icon--messages {
  color: #75d7c3;
  background: rgba(67, 201, 149, 0.11);
}

.metric-icon--evidence {
  color: #c3a8ff;
  background: rgba(155, 116, 255, 0.11);
}

.metric-card strong,
.metric-card span { display: block; }

.metric-card strong {
  color: var(--text);
  font-size: 1.25rem;
  line-height: 1.1;
}

.metric-card div > span {
  margin-top: 0.2rem;
  color: var(--muted);
  font-size: 0.78rem;
}

.report-card {
  margin-bottom: 18px;
  padding: 24px;
}

.report-card--highlight {
  position: relative;
  border-color: rgba(91, 140, 255, 0.35);
  overflow: hidden;
  background:
    linear-gradient(120deg, rgba(91, 140, 255, 0.11), transparent 45%),
    rgba(19, 26, 34, 0.97);
}

.report-card--highlight::before {
  position: absolute;
  inset: 0 auto 0 0;
  width: 3px;
  content: "";
  background: linear-gradient(180deg, var(--accent), rgba(91, 140, 255, 0.15));
}

.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 18px;
}

.section-heading--with-copy { align-items: center; }

.section-heading p:not(.section-kicker) {
  max-width: 640px;
  margin: 0.38rem 0 0;
  font-size: 0.88rem;
}

.section-icon {
  width: 36px;
  height: 36px;
}

.summary-text {
  margin: 0;
  color: var(--text-soft);
  font-size: 1.01rem;
  line-height: 1.75;
}

.markdown-body > :first-child { margin-top: 0; }
.markdown-body > :last-child { margin-bottom: 0; }

.markdown-body p,
.markdown-body ul,
.markdown-body ol,
.markdown-body blockquote,
.markdown-body pre,
.markdown-body table {
  margin: 0.65rem 0;
}

.markdown-body h1,
.markdown-body h2,
.markdown-body h3,
.markdown-body h4,
.markdown-body h5,
.markdown-body h6 {
  margin: 0.85rem 0 0.35rem;
  color: var(--text);
  font-size: 1em;
  line-height: 1.45;
}

.markdown-body ul,
.markdown-body ol { padding-left: 1.35rem; }

.markdown-body li + li { margin-top: 0.25rem; }

.markdown-body blockquote {
  padding-left: 0.85rem;
  border-left: 3px solid var(--accent);
  color: var(--muted);
}

.markdown-body pre {
  padding: 0.7rem 0.8rem;
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--surface-soft);
}

.markdown-body pre code {
  padding: 0;
  border: 0;
  background: none;
}

.markdown-body table {
  width: 100%;
  border-collapse: collapse;
}

.markdown-body th,
.markdown-body td {
  padding: 0.4rem 0.55rem;
  border: 1px solid var(--line);
  text-align: left;
}

.count-pill,
.evidence-pill,
.message-count {
  min-height: 26px;
  padding: 0.22rem 0.58rem;
  color: var(--muted);
  background: var(--surface-soft);
}

.question-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(285px, 1fr));
  gap: 13px;
}

.question-card {
  display: flex;
  min-height: 245px;
  flex-direction: column;
  gap: 15px;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 14px;
  color: inherit;
  background: var(--surface-soft);
  text-decoration: none;
  transition: border-color 150ms ease, background 150ms ease, transform 150ms ease, box-shadow 150ms ease;
}

.question-card:hover {
  border-color: rgba(118, 160, 255, 0.52);
  color: inherit;
  background: var(--surface-raised);
  box-shadow: 0 14px 28px rgba(0, 0, 0, 0.17);
  transform: translateY(-2px);
}

.question-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.question-index,
.evidence-index {
  min-height: 26px;
  padding: 0.2rem 0.55rem;
  border-color: rgba(91, 140, 255, 0.3);
  color: var(--accent-strong);
  background: var(--accent-soft);
  letter-spacing: 0.04em;
}

.question-card > h3 {
  font-size: 1.02rem;
  line-height: 1.46;
}

.question-card__answer {
  display: -webkit-box;
  margin: 0;
  overflow: hidden;
  color: var(--muted);
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.question-card__answer.markdown-body > * { margin: 0; }
.question-card__answer.markdown-body > * + * { margin-top: 0.4rem; }

.open-link {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin-top: auto;
  color: var(--accent-strong);
  font-size: 0.84rem;
  font-weight: 750;
}

.technical-details {
  margin-top: 18px;
  overflow: hidden;
  box-shadow: none;
  background: rgba(16, 23, 31, 0.72);
}

.technical-details summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  cursor: pointer;
  list-style: none;
}

.technical-details summary {
  min-height: 70px;
  padding: 15px 18px;
}

.technical-details summary::-webkit-details-marker { display: none; }

.technical-details summary strong,
.technical-details summary small { display: block; }

.technical-details summary strong {
  color: var(--text-soft);
  font-size: 0.87rem;
}

.technical-details summary small {
  margin-top: 0.18rem;
  color: var(--muted);
}

.details-chevron {
  color: var(--muted);
  transition: transform 160ms ease;
}

.technical-details[open] .details-chevron { transform: rotate(180deg); }

.technical-details__body {
  padding: 0 18px 18px;
  border-top: 1px solid var(--line);
}

.technical-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 28px;
  margin: 0;
}

.technical-grid div {
  display: flex;
  min-width: 0;
  justify-content: space-between;
  gap: 14px;
  padding: 11px 0;
  border-bottom: 1px solid rgba(38, 49, 61, 0.72);
}

.technical-grid dt {
  color: var(--muted);
  font-size: 0.76rem;
}

.technical-grid dd {
  min-width: 0;
  margin: 0;
  color: var(--text-soft);
  font-size: 0.76rem;
  text-align: right;
  overflow-wrap: anywhere;
}

.report-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 22px 4px 0;
  color: var(--muted);
  font-size: 0.75rem;
}

.report-footer span,
.report-footer a { font-weight: 750; }

.report-footer p { margin: 0; }

.top-nav {
  display: flex;
  min-height: 40px;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 12px;
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--text-soft);
  font-size: 0.82rem;
  font-weight: 700;
  text-decoration: none;
}

.back-link:hover { color: var(--text); }

.answer-body {
  color: var(--text-soft);
  font-size: 1rem;
  line-height: 1.78;
  white-space: normal;
}

.evidence-stack {
  display: grid;
  gap: 16px;
}

.evidence {
  border: 1px solid var(--line);
  border-radius: 15px;
  overflow: hidden;
  background: var(--surface-soft);
}

.evidence-header {
  display: flex;
  min-height: 76px;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 15px 18px;
  border-bottom: 1px solid var(--line);
  background: rgba(24, 33, 43, 0.72);
}

.evidence-header h3 {
  margin-top: 0.45rem;
  color: var(--muted);
  font-size: 0.78rem;
  font-weight: 600;
}

.message-thread {
  display: grid;
  gap: 13px;
  padding: 18px;
  background:
    radial-gradient(circle at 100% 0, rgba(91, 140, 255, 0.04), transparent 22rem),
    #0d141c;
}

.telegram-message {
  display: grid;
  grid-template-columns: 36px minmax(0, 1fr);
  align-items: start;
  gap: 9px;
}

.telegram-avatar {
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  border: 1px solid rgba(118, 160, 255, 0.27);
  border-radius: 50%;
  color: #dce7ff;
  background: linear-gradient(145deg, rgba(91, 140, 255, 0.45), rgba(91, 140, 255, 0.18));
  font-size: 0.78rem;
  font-weight: 800;
}

.telegram-bubble {
  position: relative;
  width: min(850px, 100%);
  padding: 11px 12px 8px;
  border: 1px solid var(--line);
  border-radius: 6px 14px 14px 14px;
  background: #17232e;
  box-shadow: 0 8px 18px rgba(0, 0, 0, 0.14);
}

.telegram-bubble::before {
  position: absolute;
  top: -1px;
  left: -7px;
  width: 0;
  height: 0;
  border-top: 10px solid #17232e;
  border-left: 8px solid transparent;
  content: "";
}

.telegram-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.sender-name {
  color: #8eafff;
  font-size: 0.82rem;
  font-weight: 800;
}

.message-anchor {
  display: grid;
  width: 25px;
  height: 25px;
  place-items: center;
  border-radius: 7px;
  color: var(--muted);
  opacity: 0.28;
  transition: color 140ms ease, background 140ms ease, opacity 140ms ease;
}

.telegram-bubble:hover .message-anchor,
.message-anchor:focus-visible {
  color: var(--accent-strong);
  opacity: 1;
  background: var(--accent-soft);
}

.message-anchor svg {
  width: 14px;
  height: 14px;
}

.message-context {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 7px;
}

.message-context span,
.translation-badge {
  min-height: 23px;
  padding: 0.16rem 0.48rem;
  color: var(--muted);
  background: rgba(132, 144, 158, 0.08);
}

.telegram-text {
  margin: 7px 0 0;
  color: var(--text);
  line-height: 1.55;
}

.empty-message {
  margin: 8px 0 2px;
  color: var(--muted);
  font-style: italic;
}

.translation-badge {
  margin-top: 9px;
  border-color: rgba(91, 140, 255, 0.28);
  color: var(--accent-strong);
  background: var(--accent-soft);
}

.translation-controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 7px;
  margin-top: 9px;
}

.translation-controls .translation-badge { margin-top: 0; }

.translation-toggle {
  display: inline-flex;
  min-height: 25px;
  align-items: center;
  gap: 5px;
  padding: 0.18rem 0.5rem;
  border: 1px solid var(--line-strong);
  border-radius: 999px;
  color: var(--text-soft);
  background: rgba(132, 144, 158, 0.07);
  font: inherit;
  font-size: 0.7rem;
  font-weight: 750;
  cursor: pointer;
  transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
}

.translation-toggle:hover,
.translation-toggle[aria-pressed="true"] {
  border-color: rgba(118, 160, 255, 0.45);
  color: var(--accent-strong);
  background: var(--accent-soft);
}

.translation-toggle:focus-visible,
.media-enrichment-toggle:focus-visible {
  outline: 3px solid rgba(118, 160, 255, 0.38);
  outline-offset: 2px;
}

.translation-toggle svg {
  width: 13px;
  height: 13px;
}

.telegram-text--original {
  padding-left: 10px;
  border-left: 2px solid var(--line-strong);
  color: var(--text-soft);
}

.translation-panel {
  margin-top: 10px;
  padding: 10px 11px;
  border-left: 2px solid var(--accent);
  border-radius: 0 9px 9px 0;
  background: var(--accent-soft);
}

.translation-panel > span {
  color: var(--accent-strong);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.translation-panel pre {
  margin: 5px 0 0;
  color: var(--text-soft);
  line-height: 1.55;
}

.attachment-stack {
  display: grid;
  gap: 7px;
  margin-top: 10px;
}

.attachment-item {
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: rgba(11, 15, 20, 0.3);
}

.attachment-item--unavailable { border-color: rgba(225, 174, 84, 0.22); }

.attachment-preview {
  position: relative;
  min-width: 0;
  overflow: hidden;
  background: #0b1118;
}

.attachment-preview__link { display: block; }

.attachment-preview img,
.attachment-preview video {
  display: block;
  width: 100%;
  max-height: 480px;
  object-fit: contain;
  background: #090e14;
}

.attachment-preview--audio {
  display: flex;
  min-height: 76px;
  align-items: center;
  padding: 17px 50px 17px 14px;
}

.attachment-preview audio {
  width: 100%;
  min-width: 0;
}

.attachment-row {
  display: flex;
  min-height: 51px;
  align-items: center;
  gap: 10px;
  padding: 7px 9px;
  border: 0;
  color: var(--text-soft);
  background: transparent;
}

.attachment-preview + .attachment-row { border-top: 1px solid var(--line); }

.attachment-row--unavailable {
  background: var(--amber-soft);
}

.attachment-icon {
  display: grid;
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 9px;
  color: var(--accent-strong);
  background: var(--accent-soft);
}

.attachment-row--unavailable .attachment-icon {
  color: var(--amber);
  background: var(--amber-soft);
}

.attachment-copy {
  display: block;
  min-width: 0;
}

.attachment-copy strong,
.attachment-copy small { display: block; }

.attachment-copy strong {
  color: var(--text-soft);
  font-size: 0.8rem;
}

.attachment-copy small {
  margin-top: 0.1rem;
  color: var(--muted);
  font-size: 0.68rem;
}

.attachment-action {
  margin-left: auto;
  color: var(--accent-strong);
  font-size: 0.76rem;
  font-weight: 750;
  text-decoration: none;
}

.attachment-action:hover { text-decoration: underline; }

.reason-tag {
  min-height: 24px;
  margin-left: auto;
  padding: 0.16rem 0.5rem;
  border-color: rgba(225, 174, 84, 0.28);
  color: #edc77f;
  background: var(--amber-soft);
}

.media-enrichment-toggle {
  display: grid;
  width: 30px;
  height: 30px;
  flex: 0 0 auto;
  place-items: center;
  padding: 0;
  border: 1px solid rgba(118, 160, 255, 0.4);
  border-radius: 9px;
  color: #dce7ff;
  background: rgba(14, 24, 36, 0.9);
  box-shadow: 0 5px 14px rgba(0, 0, 0, 0.25);
  cursor: pointer;
  transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
}

.attachment-preview > .media-enrichment-toggle {
  position: absolute;
  z-index: 2;
  top: 9px;
  right: 9px;
}

.attachment-row > .media-enrichment-toggle { margin-left: 2px; }

.media-enrichment-toggle:hover,
.media-enrichment-toggle[aria-expanded="true"] {
  border-color: var(--accent-strong);
  color: #fff;
  background: rgba(91, 140, 255, 0.82);
}

.media-enrichment-toggle svg {
  width: 17px;
  height: 17px;
}

.media-enrichment-panel {
  display: grid;
  max-height: 440px;
  gap: 11px;
  padding: 13px 14px;
  overflow: auto;
  border-top: 1px solid var(--line);
  background: rgba(91, 140, 255, 0.055);
}

.media-enrichment-panel[hidden] { display: none; }

.media-enrichment-panel section + section {
  padding-top: 11px;
  border-top: 1px solid var(--line);
}

.media-enrichment-panel h4 {
  margin: 0 0 5px;
  color: var(--accent-strong);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.media-enrichment-panel p,
.media-enrichment-panel pre {
  margin: 0;
  color: var(--text-soft);
  line-height: 1.55;
}

.media-enrichment-panel__notice { color: var(--muted) !important; }

.reaction-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 8px;
}

.reaction-chip {
  display: inline-flex;
  min-height: 23px;
  align-items: center;
  padding: 0.12rem 0.48rem;
  border: 1px solid rgba(91, 140, 255, 0.23);
  border-radius: 999px;
  color: var(--text-soft);
  background: var(--accent-soft);
  font-size: 0.77rem;
}

.telegram-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 6px;
  color: var(--muted);
  font-size: 0.68rem;
}

.inline-notice {
  display: grid;
  gap: 2px;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 10px;
  color: var(--text-soft);
  background: var(--surface-soft);
}

.inline-notice span {
  color: var(--muted);
  font-size: 0.78rem;
}

.inline-notice--warning { border-color: rgba(225, 174, 84, 0.28); }

.media-library-mix {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
  margin: -3px 0 17px;
  padding-bottom: 15px;
  border-bottom: 1px solid var(--line);
}

.media-library-mix__label {
  margin-right: 3px;
  color: var(--muted);
  font-size: 0.7rem;
  font-weight: 750;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.media-library-mix__item {
  display: inline-flex;
  min-height: 28px;
  align-items: center;
  gap: 6px;
  padding: 0.25rem 0.62rem;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--text-soft);
  background: var(--surface-soft);
  font-size: 0.75rem;
}

.media-library-mix__item strong { color: var(--accent-strong); }

.media-gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
  align-items: start;
  gap: 15px;
}

.media-gallery-card {
  display: flex;
  min-width: 0;
  min-height: 410px;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface-soft);
  transition: border-color 140ms ease, background 140ms ease, transform 140ms ease;
}

.media-gallery-card:hover {
  border-color: var(--line-strong);
  background: var(--surface-raised);
  transform: translateY(-1px);
}

.media-gallery-card--unavailable { border-color: rgba(225, 174, 84, 0.22); }

.media-gallery-card__preview {
  position: relative;
  display: grid;
  aspect-ratio: 4 / 3;
  min-height: 0;
  place-items: center;
  overflow: hidden;
  border-bottom: 1px solid var(--line);
  background:
    radial-gradient(circle at 70% 18%, rgba(91, 140, 255, 0.16), transparent 45%),
    #0b1118;
}

.media-preview-link,
.media-preview-link img,
.media-gallery-card__preview video {
  width: 100%;
  height: 100%;
}

.media-preview-link { display: block; }

.media-preview-link img,
.media-gallery-card__preview video {
  object-fit: cover;
}

.media-preview-link__action {
  position: absolute;
  right: 10px;
  bottom: 10px;
  padding: 0.3rem 0.56rem;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 8px;
  color: #fff;
  background: rgba(7, 11, 16, 0.78);
  font-size: 0.7rem;
  font-weight: 750;
  opacity: 0;
  transform: translateY(3px);
  transition: opacity 140ms ease, transform 140ms ease;
}

.media-preview-link:hover .media-preview-link__action,
.media-preview-link:focus-visible .media-preview-link__action {
  opacity: 1;
  transform: translateY(0);
}

.media-gallery-card__preview--audio {
  align-content: center;
  gap: 16px;
  padding: 24px 14px 14px;
}

.media-audio-art {
  display: grid;
  justify-items: center;
  gap: 8px;
  color: var(--accent-strong);
  font-size: 0.72rem;
  font-weight: 750;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.media-audio-art svg {
  width: 48px;
  height: 48px;
  padding: 11px;
  border: 1px solid rgba(118, 160, 255, 0.3);
  border-radius: 50%;
  background: var(--accent-soft);
}

.media-gallery-card__preview audio {
  width: 100%;
  min-width: 0;
}

.media-file-preview {
  display: grid;
  justify-items: center;
  gap: 6px;
  color: var(--text-soft);
  font-size: 0.8rem;
  font-weight: 750;
  text-align: center;
  text-decoration: none;
}

.media-file-preview:hover { color: var(--text); }

.media-file-preview small {
  color: var(--muted);
  font-size: 0.68rem;
  font-weight: 550;
}

.media-file-preview__icon {
  display: grid;
  width: 54px;
  height: 54px;
  place-items: center;
  border: 1px solid rgba(118, 160, 255, 0.28);
  border-radius: 14px;
  color: var(--accent-strong);
  background: var(--accent-soft);
}

.media-file-preview__icon svg {
  width: 27px;
  height: 27px;
}

.media-file-preview--unavailable,
.media-file-preview--unavailable small { color: #edc77f; }

.media-file-preview--unavailable .media-file-preview__icon {
  border-color: rgba(225, 174, 84, 0.28);
  color: var(--amber);
  background: var(--amber-soft);
}

.media-gallery-card__body {
  display: flex;
  min-height: 180px;
  flex: 1;
  flex-direction: column;
  padding: 14px 15px 15px;
}

.media-gallery-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
}

.availability-tag {
  min-height: 24px;
  padding: 0.16rem 0.5rem;
  font-size: 0.68rem;
}

.availability-tag--warning {
  border-color: rgba(225, 174, 84, 0.28);
  color: #edc77f;
  background: var(--amber-soft);
}

.media-type {
  color: var(--accent-strong);
  font-size: 0.66rem;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.media-gallery-card h3 {
  margin-top: 0;
  overflow-wrap: anywhere;
}

.media-gallery-card h3 a {
  color: var(--text);
  text-decoration: none;
}

.media-gallery-card h3 a:hover { color: var(--accent-strong); }

.media-byline {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 0.42rem;
  color: var(--text-soft);
  font-size: 0.72rem;
}

.media-timestamp {
  margin-top: 0.18rem;
  color: var(--muted);
  font-size: 0.68rem;
}

.media-open {
  width: fit-content;
  margin-top: auto;
  padding-top: 11px;
  color: var(--accent-strong);
  font-size: 0.75rem;
  font-weight: 750;
  text-decoration: none;
}

.media-open:hover { text-decoration: underline; }

.media-reason {
  display: flex;
  width: fit-content;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: auto;
  padding: 0.32rem 0.55rem;
  border: 1px solid rgba(225, 174, 84, 0.25);
  border-radius: 999px;
  color: #edc77f;
  background: var(--amber-soft);
  font-size: 0.71rem;
}

.media-reason span {
  color: var(--muted);
  font-weight: 650;
}

.empty-state {
  display: grid;
  min-height: 220px;
  place-items: center;
  align-content: center;
  padding: 28px;
  border: 1px dashed var(--line-strong);
  border-radius: 14px;
  text-align: center;
  background: var(--surface-soft);
}

.empty-state__icon {
  margin-bottom: 11px;
  font-weight: 800;
}

.empty-state h3 { margin-bottom: 0.3rem; }

.empty-state p {
  max-width: 440px;
  margin-bottom: 0;
}

.empty-state--warning {
  border-color: rgba(225, 174, 84, 0.35);
}

.empty-state--warning .empty-state__icon {
  color: var(--amber);
  background: var(--amber-soft);
}

.report-highlight .telegram-bubble {
  outline: 2px solid var(--accent-strong);
  outline-offset: 3px;
  animation: report-pulse 1.2s ease-out 1;
}

@keyframes report-pulse {
  0% { box-shadow: 0 0 0 0 rgba(91, 140, 255, 0.45); }
  100% { box-shadow: 0 0 0 12px rgba(91, 140, 255, 0); }
}

:root[data-theme="light"] {
  color-scheme: light;
  --bg: #dfeaf2;
  --surface: #ffffff;
  --surface-raised: #f7fbfe;
  --surface-soft: #f1f6f9;
  --line: #d7e2e9;
  --line-strong: #c3d3dd;
  --text: #1f2d3d;
  --text-soft: #415568;
  --muted: #718492;
  --accent: #3390ec;
  --accent-strong: #2481cc;
  --accent-soft: rgba(51, 144, 236, 0.12);
  --green: #32966d;
  --green-soft: rgba(50, 150, 109, 0.11);
  --amber: #ad731b;
  --amber-soft: rgba(196, 132, 35, 0.11);
  --red: #d84f5d;
  --shadow: 0 16px 40px rgba(55, 83, 104, 0.13);
}

:root[data-theme="light"] body {
  background:
    radial-gradient(circle at 74% -10%, rgba(51, 144, 236, 0.16), transparent 34rem),
    radial-gradient(circle at 8% 28%, rgba(255, 255, 255, 0.78), transparent 26rem),
    var(--bg);
}

:root[data-theme="light"] ::selection {
  color: #16324a;
  background: rgba(51, 144, 236, 0.28);
}

:root[data-theme="light"] a:hover { color: #1168ad; }

:root[data-theme="light"] .report-hero,
:root[data-theme="light"] .report-card,
:root[data-theme="light"] .technical-details {
  background: rgba(255, 255, 255, 0.96);
}

:root[data-theme="light"] .report-hero {
  background:
    linear-gradient(118deg, rgba(51, 144, 236, 0.13), transparent 50%),
    rgba(255, 255, 255, 0.97);
}

:root[data-theme="light"] .report-hero::before {
  background: linear-gradient(90deg, transparent, rgba(51, 144, 236, 0.72), transparent 78%);
}

:root[data-theme="light"] .report-hero::after {
  background: radial-gradient(circle, rgba(51, 144, 236, 0.13), transparent 67%);
}

:root[data-theme="light"] .report-mark {
  border-color: rgba(51, 144, 236, 0.3);
  color: #2479bc;
  background: linear-gradient(145deg, rgba(51, 144, 236, 0.2), rgba(51, 144, 236, 0.07));
  box-shadow: 0 10px 25px rgba(61, 101, 132, 0.15);
}

:root[data-theme="light"] .status-pill {
  background: rgba(88, 115, 134, 0.07);
}

:root[data-theme="light"] .status-pill--ready,
:root[data-theme="light"] .availability-tag--ready {
  border-color: rgba(50, 150, 109, 0.28);
  color: #287e5b;
}

:root[data-theme="light"] .status-pill--warning,
:root[data-theme="light"] .availability-tag--warning,
:root[data-theme="light"] .reason-tag,
:root[data-theme="light"] .media-file-preview--unavailable,
:root[data-theme="light"] .media-file-preview--unavailable small,
:root[data-theme="light"] .media-reason {
  color: #966116;
}

:root[data-theme="light"] .button--secondary,
:root[data-theme="light"] .button--secondary:hover {
  border-color: var(--line-strong);
  color: var(--text-soft);
  background: rgba(255, 255, 255, 0.82);
}

:root[data-theme="light"] .button--secondary:hover {
  border-color: rgba(51, 144, 236, 0.5);
  color: var(--text);
  background: #ffffff;
}

:root[data-theme="light"] .metric-card {
  background: rgba(255, 255, 255, 0.84);
}

:root[data-theme="light"] .metric-icon--messages { color: #2b8e79; }
:root[data-theme="light"] .metric-icon--evidence { color: #7455b8; }

:root[data-theme="light"] .report-card--highlight {
  background:
    linear-gradient(120deg, rgba(51, 144, 236, 0.1), transparent 46%),
    rgba(255, 255, 255, 0.98);
}

:root[data-theme="light"] .technical-details {
  background: rgba(239, 246, 250, 0.9);
}

:root[data-theme="light"] .technical-grid div {
  border-bottom-color: rgba(195, 211, 221, 0.72);
}

:root[data-theme="light"] .evidence-header {
  background: rgba(237, 244, 249, 0.88);
}

:root[data-theme="light"] .message-thread {
  background:
    radial-gradient(circle at 16px 16px, rgba(51, 144, 236, 0.065) 0 1.5px, transparent 1.7px) 0 0 / 32px 32px,
    linear-gradient(145deg, #dce9f1, #e6eff5);
}

:root[data-theme="light"] .telegram-avatar {
  border-color: rgba(51, 144, 236, 0.25);
  color: #ffffff;
  background: linear-gradient(145deg, #55a7ef, #2f86d1);
}

:root[data-theme="light"] .telegram-bubble {
  border-color: #cadbe6;
  background: #ffffff;
  box-shadow: 0 5px 15px rgba(65, 91, 110, 0.12);
}

:root[data-theme="light"] .telegram-bubble::before {
  border-top-color: #ffffff;
}

:root[data-theme="light"] .sender-name { color: #168acd; }

:root[data-theme="light"] .message-context span,
:root[data-theme="light"] .translation-badge,
:root[data-theme="light"] .translation-toggle {
  background: rgba(71, 103, 126, 0.07);
}

:root[data-theme="light"] .attachment-item {
  background: rgba(244, 248, 251, 0.9);
}

:root[data-theme="light"] .attachment-preview,
:root[data-theme="light"] .media-gallery-card__preview {
  background:
    radial-gradient(circle at 70% 18%, rgba(51, 144, 236, 0.13), transparent 45%),
    #dce8ef;
}

:root[data-theme="light"] .attachment-preview img,
:root[data-theme="light"] .attachment-preview video {
  background: #dce8ef;
}

:root[data-theme="light"] .media-enrichment-panel {
  background: rgba(51, 144, 236, 0.07);
}

:root[data-theme="light"] .inline-notice {
  background: rgba(255, 255, 255, 0.72);
}

@media (max-width: 820px) {
  .report-hero {
    min-height: 0;
    align-items: flex-start;
    flex-direction: column;
  }

  .report-hero__actions {
    width: 100%;
    align-items: flex-start;
  }

  .report-hero__buttons { justify-content: flex-start; }

  .summary-metrics { grid-template-columns: 1fr; }
  .technical-grid { grid-template-columns: 1fr; }
}

@media (max-width: 600px) {
  body { font-size: 14px; }

  .report-shell {
    width: calc(100vw - 18px);
    padding: 10px 0 36px;
  }

  .report-hero,
  .report-card {
    padding: 17px;
    border-radius: 14px;
  }

  .report-hero__main { gap: 12px; }

  .report-mark {
    width: 40px;
    height: 40px;
    border-radius: 11px;
  }

  .report-mark svg {
    width: 21px;
    height: 21px;
  }

  .question-grid,
  .media-gallery-grid { grid-template-columns: 1fr; }

  .section-heading--with-copy,
  .evidence-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .message-thread { padding: 12px; }

  .telegram-message {
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 7px;
  }

  .telegram-avatar {
    width: 28px;
    height: 28px;
    font-size: 0.68rem;
  }

  .attachment-row { align-items: flex-start; }

  .attachment-action,
  .reason-tag {
    align-self: center;
    margin-left: auto;
  }

  .report-footer {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;
  }
}

@media print {
  :root { color-scheme: light; }

  body {
    color: #17202a;
    background: #fff;
  }

  .report-shell { width: 100%; }

  .report-hero,
  .report-card,
  .technical-details,
  .metric-card,
  .evidence,
  .telegram-bubble,
  .question-card,
  .media-gallery-card {
    border-color: #d8dee6;
    color: #17202a;
    background: #fff;
    box-shadow: none;
  }

  .report-hero__actions,
  .top-nav,
  .message-anchor,
  .translation-toggle,
  .media-enrichment-toggle,
  .report-footer { display: none; }

  .summary-text,
  .answer-body,
  .telegram-text,
  .question-card h3 { color: #17202a; }
}
