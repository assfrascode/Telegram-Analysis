<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Media · Chat Analysis</title>
  <link rel="stylesheet" href="assets/report.css">
  <script defer src="assets/report.js"></script>
</head>
<body>
  <main class="report-shell report-shell--gallery">
    <nav class="top-nav" aria-label="Report navigation">
      <a class="back-link" href="index.html"><span aria-hidden="true">←</span> Back to overview</a>
      <div class="top-nav__actions">
        <span class="quiet-meta">{{ media_gallery|length }} attachment{% if media_gallery|length != 1 %}s{% endif %}</span>
        <button class="theme-toggle theme-toggle--compact" type="button" data-theme-toggle aria-label="Switch to light mode" title="Switch to light mode">
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.6"/><path d="M12 3.5v2M12 18.5v2M3.5 12h2M18.5 12h2M6 6l1.4 1.4M16.6 16.6 18 18M18 6l-1.4 1.4M7.4 16.6 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 15.3A7.7 7.7 0 0 1 8.7 5a7.7 7.7 0 1 0 10.3 10.3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          <span data-theme-label>Light mode</span>
        </button>
      </div>
    </nav>

    <header class="report-hero report-hero--gallery">
      <div class="report-hero__main">
        <div class="report-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M4.75 6.75A2 2 0 0 1 6.75 4.75h10.5a2 2 0 0 1 2 2v10.5a2 2 0 0 1-2 2H6.75a2 2 0 0 1-2-2z" stroke="currentColor" stroke-width="1.6"/>
            <path d="m7.5 16 3.2-3.4 2.15 2.15 1.65-1.65 2.25 2.9M15.75 9.1h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="report-hero__copy">
          <div class="hero-label-row"><span class="status-pill"><span class="status-dot"></span>Reference library</span></div>
          <p class="eyebrow">Chat analysis{% if job.source_name %} · {{ job.source_name }}{% endif %}</p>
          <h1>Media</h1>
          <p class="lead">A visual library of the photos, videos, and recordings shared in this chat.</p>
        </div>
      </div>
      <time class="generated-at" datetime="{{ generated_at.isoformat() }}">Generated {{ generated_at.strftime("%b %d, %Y · %H:%M UTC") }}</time>
    </header>

    <section class="report-card">
      <div class="section-heading section-heading--with-copy">
        <div>
          <p class="section-kicker">Shared attachments</p>
          <h2>Media library</h2>
          <p>Browse the chat's media at a glance. Select any available item to open the original file.</p>
        </div>
        <span class="count-pill">{{ media_gallery|length }} total</span>
      </div>

      {% if media_gallery %}
      <div class="media-library-mix" aria-label="Media types in this chat">
        <span class="media-library-mix__label">Media mix</span>
        {% for group in media_gallery|groupby("media_type") %}
        <span class="media-library-mix__item">{{ group.grouper|replace("_", " ")|title }} <strong>{{ group.list|length }}</strong></span>
        {% endfor %}
      </div>

      <div class="media-gallery-grid">
        {% for media in media_gallery %}
        <article class="media-gallery-card{% if not media.relative_href %} media-gallery-card--unavailable{% endif %}">
          <div class="media-gallery-card__preview media-gallery-card__preview--{{ media.preview_kind }}">
            {% if media.relative_href and media.preview_kind == "image" %}
            <a class="media-preview-link" href="{{ media.relative_href }}" aria-label="Open original image: {{ media.filename }}">
              <img src="{{ media.relative_href }}" alt="{{ media.filename }}" loading="lazy" decoding="async">
              <span class="media-preview-link__action">View original <span aria-hidden="true">↗</span></span>
            </a>
            {% elif media.relative_href and media.preview_kind == "video" %}
            <video controls preload="metadata" playsinline aria-label="Video: {{ media.filename }}">
              <source src="{{ media.relative_href }}">
              <a href="{{ media.relative_href }}">Open video</a>
            </video>
            {% elif media.relative_href and media.preview_kind == "audio" %}
            <div class="media-audio-art" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M9 17.5V6.25l8-1.5V16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6.5" cy="17.5" r="2.5" stroke="currentColor" stroke-width="1.7"/><circle cx="14.5" cy="16" r="2.5" stroke="currentColor" stroke-width="1.7"/></svg>
              <span>{{ "Voice message" if media.media_type == "voice" else "Audio" }}</span>
            </div>
            <audio controls preload="metadata" src="{{ media.relative_href }}" aria-label="Audio: {{ media.filename }}">
              <a href="{{ media.relative_href }}">Open audio</a>
            </audio>
            {% elif media.relative_href %}
            <a class="media-file-preview" href="{{ media.relative_href }}" aria-label="Open original file: {{ media.filename }}">
              <span class="media-file-preview__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M6.5 3.75h7l4 4v12.5h-11z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M13.5 3.75v4h4M9.5 12h5M9.5 15.5h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </span>
              <span>Preview unavailable</span>
              <small>Open original file</small>
            </a>
            {% else %}
            <div class="media-file-preview media-file-preview--unavailable">
              <span class="media-file-preview__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M6.5 3.75h7l4 4v12.5h-11z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M5 5l14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </span>
              <span>Original unavailable</span>
              <small>{{ media.link_unavailable_reason or "File unavailable" }}</small>
            </div>
            {% endif %}
          </div>

          <div class="media-gallery-card__body">
            <div class="media-gallery-card__top">
              <span class="media-type">{{ media.media_type|replace("_", " ")|upper }}</span>
              {% if media.relative_href %}
              <span class="availability-tag availability-tag--ready"><span class="status-dot"></span>Available</span>
              {% else %}
              <span class="availability-tag availability-tag--warning">Unavailable</span>
              {% endif %}
            </div>

            <h3>{% if media.relative_href %}<a href="{{ media.relative_href }}">{{ media.filename }}</a>{% else %}{{ media.filename }}{% endif %}</h3>
            <div class="media-byline">
              <span>{{ media.sender_name or "Unknown sender" }}</span>
              {% if media.size_label %}<span aria-hidden="true">·</span><span>{{ media.size_label }}</span>{% endif %}
            </div>
            <div class="media-timestamp">
              {% if media.timestamp_iso %}<time datetime="{{ media.timestamp_iso }}">{{ media.timestamp }}</time>{% else %}<span>{{ media.timestamp }}</span>{% endif %}
            </div>

            {% if media.relative_href %}
            <a class="media-open" href="{{ media.relative_href }}">Open original <span aria-hidden="true">↗</span></a>
            {% else %}
            <div class="media-reason"><span>Reason</span><strong>{{ media.link_unavailable_reason or "File unavailable" }}</strong></div>
            {% endif %}
          </div>
        </article>
        {% endfor %}
      </div>
      {% else %}
      <div class="empty-state">
        <span class="empty-state__icon" aria-hidden="true">◇</span>
        <h3>No attachments</h3>
        <p>No media references were captured for this chat.</p>
      </div>
      {% endif %}
    </section>

    <footer class="report-footer">
      <a href="index.html">Back to report overview</a>
      <p>Previews and attachment links work when this report stays with its original Telegram export.</p>
    </footer>
  </main>
</body>
</html>
