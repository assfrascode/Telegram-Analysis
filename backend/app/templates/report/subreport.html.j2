<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Question {{ question.index }} · Chat Analysis</title>
  <link rel="stylesheet" href="../assets/report.css">
  <script defer src="../assets/report.js"></script>
</head>
<body>
  <main class="report-shell report-shell--subreport">
    <nav class="top-nav" aria-label="Report navigation">
      <a class="back-link" href="../index.html">
        <span aria-hidden="true">←</span> Back to overview
      </a>
      <div class="top-nav__actions">
        <span class="quiet-meta">Question {{ "%02d"|format(question.index) }}</span>
        <button class="theme-toggle theme-toggle--compact" type="button" data-theme-toggle aria-label="Switch to light mode" title="Switch to light mode">
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.6"/><path d="M12 3.5v2M12 18.5v2M3.5 12h2M18.5 12h2M6 6l1.4 1.4M16.6 16.6 18 18M18 6l-1.4 1.4M7.4 16.6 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 15.3A7.7 7.7 0 0 1 8.7 5a7.7 7.7 0 1 0 10.3 10.3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          <span data-theme-label>Light mode</span>
        </button>
      </div>
    </nav>

    <header class="report-hero report-hero--question">
      <div class="report-hero__main">
        <div class="report-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/>
            <path d="M9.85 9.5a2.3 2.3 0 1 1 3.15 2.14c-.7.3-1 .75-1 1.36v.25M12 16.6h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="report-hero__copy">
          <div class="hero-label-row">
            <span class="status-pill{% if question.status == "completed" %} status-pill--ready{% else %} status-pill--warning{% endif %}"><span class="status-dot"></span>{{ question.status|replace("_", " ")|title }}</span>
            <span class="evidence-pill">{{ question.evidence|length }} evidence section{% if question.evidence|length != 1 %}s{% endif %}</span>
          </div>
          <p class="eyebrow">Question {{ "%02d"|format(question.index) }}</p>
          <h1>{{ question.question }}</h1>
          <p class="lead">Answer and supporting source messages.</p>
        </div>
      </div>
      <time class="generated-at" datetime="{{ generated_at.isoformat() }}">Generated {{ generated_at.strftime("%b %d, %Y · %H:%M UTC") }}</time>
    </header>

    <section class="report-card report-card--highlight answer-card">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Analysis</p>
          <h2>Answer</h2>
        </div>
        <span class="section-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M7.5 7.5h9M7.5 11.5h9M7.5 15.5h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M5 3.75h14v16.5H5z" stroke="currentColor" stroke-width="1.6"/></svg>
        </span>
      </div>
      <article class="answer-body markdown-body">{{ question.answer|report_markdown }}</article>
    </section>

    <section class="report-card evidence-section">
      <div class="section-heading section-heading--with-copy">
        <div>
          <p class="section-kicker">Evidence</p>
          <h2>Supporting messages</h2>
          <p>Original chat messages selected for this answer.</p>
        </div>
        <span class="count-pill">{{ question.evidence|length }} section{% if question.evidence|length != 1 %}s{% endif %}</span>
      </div>

      {% if question.evidence %}
      <div class="evidence-stack">
        {% for item in question.evidence %}
        <article class="evidence" id="chunk-{{ item.chunk_index }}">
          <header class="evidence-header">
            <div>
              <span class="evidence-index">Evidence {{ "%02d"|format(loop.index) }}</span>
              <h3>{{ item.start_timestamp }} <span aria-hidden="true">→</span> {{ item.end_timestamp }}</h3>
            </div>
            <span class="message-count">{{ item.messages|length }} message{% if item.messages|length != 1 %}s{% endif %}</span>
          </header>

          <div class="message-thread" aria-label="Original messages">
            {% if item.messages %}
              {% for msg in item.messages %}
              <article class="telegram-message" id="msg-{{ msg.telegram_message_id }}">
                <div class="telegram-avatar" aria-hidden="true">{{ (msg.sender_name or "?")[:1] | upper }}</div>
                <div class="telegram-bubble">
                  <header class="telegram-header">
                    <span class="sender-name">{{ msg.sender_name or "Unknown sender" }}</span>
                    <a class="message-anchor" href="#msg-{{ msg.telegram_message_id }}" title="Link to this message" aria-label="Link to this message">
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9.5 14.5 5-5M8.2 17.8l-2 .2a3 3 0 0 1-.2-6l3-.3M15.8 6.2l2-.2a3 3 0 0 1 .2 6l-3 .3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    </a>
                  </header>

                  {% if msg.reply_to_message_id or msg.forwarded_from %}
                  <div class="message-context">
                    {% if msg.reply_to_message_id %}<span>Reply</span>{% endif %}
                    {% if msg.forwarded_from %}<span>Forwarded message</span>{% endif %}
                  </div>
                  {% endif %}

                  <div{% if msg.original_text %} class="message-text-switch" data-message-text-switch{% endif %}>
                    <div{% if msg.original_text %} data-message-text-version="translated"{% endif %}>
                      {% if msg.text == "[NO_TEXT]" %}
                      <p class="empty-message">This message has no text.</p>
                      {% elif msg.text == "[ENGLISH_TRANSLATION_UNAVAILABLE]" %}
                      <p class="empty-message">English translation unavailable.</p>
                      {% else %}
                      <pre class="telegram-text">{{ msg.text }}</pre>
                      {% endif %}
                    </div>

                    {% if msg.original_text %}
                    <pre class="telegram-text telegram-text--original" data-message-text-version="original" hidden>{{ msg.original_text }}</pre>
                    <div class="translation-controls">
                      {% if msg.translation_applied %}<span class="translation-badge">Translated to English</span>{% endif %}
                      <button class="translation-toggle" type="button" data-message-text-toggle data-translated-label="{% if msg.translation_applied %}Show English translation{% else %}Show translation status{% endif %}" aria-pressed="false">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h11M11 4l4 3-4 3M20 17H9M13 14l-4 3 4 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span data-message-text-toggle-label>Show original message</span>
                      </button>
                    </div>
                    {% elif msg.translation_applied %}
                    <span class="translation-badge">Translated to English</span>
                    {% endif %}
                  </div>

                  {% if not msg.translation_applied and msg.translation_text %}
                  <div class="translation-panel">
                    <span>English translation</span>
                    <pre>{{ msg.translation_text }}</pre>
                  </div>
                  {% endif %}

                  {% if msg.media %}
                  <div class="attachment-stack">
                    {% for media in msg.media %}
                      {% set is_image = media.preview_kind == "image" %}
                      {% set is_video = media.preview_kind == "video" %}
                      {% set is_audio = media.preview_kind == "audio" %}
                      <article class="attachment-item{% if not media.relative_href %} attachment-item--unavailable{% endif %}">
                        {% if media.relative_href and (is_image or is_video or is_audio) %}
                        <div class="attachment-preview attachment-preview--{{ "image" if is_image else "video" if is_video else "audio" }}">
                          {% if is_image %}
                          <a class="attachment-preview__link" href="{{ media.relative_href }}" aria-label="Open original {{ media.media_type|replace('_', ' ') }} attachment">
                            <img src="{{ media.relative_href }}" alt="{{ media.media_type|replace('_', ' ')|title }} attachment" loading="lazy" decoding="async">
                          </a>
                          {% elif is_video %}
                          <video controls preload="metadata">
                            <source src="{{ media.relative_href }}">
                            Your browser cannot play this video. <a href="{{ media.relative_href }}">Open the original file</a>.
                          </video>
                          {% else %}
                          <audio controls preload="metadata" src="{{ media.relative_href }}">
                            Your browser cannot play this audio. <a href="{{ media.relative_href }}">Open the original file</a>.
                          </audio>
                          {% endif %}
                          <button class="media-enrichment-toggle" type="button" data-media-enrichment-toggle aria-expanded="false" aria-controls="media-enrichment-{{ item.id }}-{{ msg.id }}-{{ loop.index }}" title="Show description and transcription">
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><path d="M12 10.7v5M12 7.7h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                            <span class="visually-hidden">Show description and transcription</span>
                          </button>
                        </div>
                        {% endif %}

                        <div class="attachment-row{% if not media.relative_href %} attachment-row--unavailable{% endif %}">
                          <span class="attachment-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none"><path d="m9 12.5 5.3-5.3a3 3 0 0 1 4.25 4.25l-7.1 7.1a4.5 4.5 0 0 1-6.36-6.36l7.1-7.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>{% if media.relative_href %}<path d="m8.1 15.4 6.7-6.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>{% else %}<path d="M5 5l14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>{% endif %}</svg>
                          </span>
                          <span class="attachment-copy"><strong>{{ media.media_type|replace("_", " ")|title }} attachment</strong><small>{% if media.relative_href %}Original file{% else %}Original unavailable{% endif %}</small></span>
                          {% if media.relative_href %}
                          <a class="attachment-action" href="{{ media.relative_href }}">Open <span aria-hidden="true">↗</span></a>
                          {% else %}
                          <span class="reason-tag">{{ media.unavailable_reason or "File unavailable" }}</span>
                          {% endif %}
                          {% if not (media.relative_href and (is_image or is_video or is_audio)) %}
                          <button class="media-enrichment-toggle" type="button" data-media-enrichment-toggle aria-expanded="false" aria-controls="media-enrichment-{{ item.id }}-{{ msg.id }}-{{ loop.index }}" title="Show description and transcription">
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><path d="M12 10.7v5M12 7.7h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                            <span class="visually-hidden">Show description and transcription</span>
                          </button>
                          {% endif %}
                        </div>

                        <div class="media-enrichment-panel" id="media-enrichment-{{ item.id }}-{{ msg.id }}-{{ loop.index }}" hidden>
                          {% if media.description %}
                          <section>
                            <h4>Description</h4>
                            <p>{{ media.description }}</p>
                          </section>
                          {% endif %}
                          {% if media.transcript_text %}
                          <section>
                            <h4>Transcription</h4>
                            <pre>{{ media.transcript_text }}</pre>
                          </section>
                          {% elif media.transcript_error %}
                          <section>
                            <h4>Transcription</h4>
                            <p class="media-enrichment-panel__notice">{{ media.transcript_error }}</p>
                          </section>
                          {% endif %}
                          {% if not media.description and not media.transcript_text and not media.transcript_error %}
                          <p class="media-enrichment-panel__notice">No generated description or transcription is available for this file.</p>
                          {% endif %}
                      </div>
                      </article>
                    {% endfor %}
                  </div>
                  {% endif %}

                  {% if msg.reaction_chips %}
                  <div class="reaction-bar" aria-label="Reactions">
                    {% for reaction in msg.reaction_chips %}<span class="reaction-chip">{{ reaction }}</span>{% endfor %}
                  </div>
                  {% endif %}

                  <footer class="telegram-footer">
                    <time datetime="{{ msg.timestamp_iso }}">{{ msg.timestamp }}</time>
                    {% if msg.edited_timestamp %}<span>Edited</span>{% endif %}
                  </footer>
                </div>
              </article>
              {% endfor %}
            {% else %}
            <div class="inline-notice inline-notice--warning">
              <strong>Original messages unavailable</strong>
              <span>The technical evidence text is still available below.</span>
            </div>
            {% endif %}
          </div>
        </article>
        {% endfor %}
      </div>
      {% else %}
      <div class="empty-state empty-state--warning">
        <span class="empty-state__icon" aria-hidden="true">!</span>
        <h3>No supporting evidence selected</h3>
        <p>No evidence sections were marked as answer context for this question.</p>
      </div>
      {% endif %}
    </section>

    <footer class="report-footer">
      <a href="../index.html">Back to report overview</a>
      <p>Attachment links work when this report stays with its original Telegram export.</p>
    </footer>
  </main>
</body>
</html>
